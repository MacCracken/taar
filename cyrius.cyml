[package]
name = "taar"
version = "${file:VERSION}"
description = "तार — wire / string / connection. Network-probe substrate library for AGNOS first-party net tools (yo, dig, whirl): IPv4 address codec, UDP + TCP socket primitives (Linux + AGNOS), and an A-record stub resolver with TCP fallback. Sanskrit/Hindi system-lib naming lane."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/taar"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "programs/smoke.cyr"
output = "build/taar-smoke"
test = "src/test.cyr"

[lib]
# `cyrius distlib` concatenates these (in order) into dist/taar.cyr;
# consumers `include "lib/taar.cyr"` after `cyrius deps` resolves the
# dep. Single-pass compiler: each module may only reference symbols
# defined in earlier modules. src/main.cyr is the in-tree convenience
# entry (includes all modules for smoke + tests) and is intentionally
# NOT listed — it would duplicate the module bodies in the dist bundle.
modules = ["src/ipv4.cyr", "src/socket.cyr", "src/dns.cyr"]

[deps]
# taar's own build list. The shipped bundle needs only `syscalls` + `fmt`
# (ipv4_format_to_buf calls fmt_int_buf); `distlib` compile-verifies that
# and writes it to dist/taar.deps. `assert` and `alloc` serve the test
# suite and the smoke programs and never reach consumers.
stdlib = ["syscalls", "fmt", "assert", "alloc"]

[test]
# Test / bench / fuzz compiles only — never a build, never the sidecar.
stdlib = ["bench"]
