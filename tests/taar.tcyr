# taar test suite — the substrate surface, offline.
#
# Stdlib auto-included via cyrius.cyml. Pure codecs and parsers are driven
# directly; socket contracts that need a peer use an AF_UNIX socketpair, never
# the network. What needs a resolver — the TC retry, a filtered TCP/53 — lives
# in tests/integration/tc_fallback.sh, inside a private network namespace.
# Everything here runs the Linux arm of socket.cyr; the AGNOS arm executes in
# tests/agnos/run.sh, on the agnos kernel under QEMU.

include "src/ipv4.cyr"
include "src/socket.cyr"
include "src/dns.cyr"

# === IPv4 parser ===
fn test_ipv4_parse() {
    test_group("taar_ipv4_parse");
    # Valid.
    assert_eq(taar_ipv4_parse("0.0.0.0"),         0x00000000, "ipv4 zeros");
    assert_eq(taar_ipv4_parse("127.0.0.1"),       0x7F000001, "ipv4 loopback");
    assert_eq(taar_ipv4_parse("8.8.8.8"),         0x08080808, "ipv4 google");
    assert_eq(taar_ipv4_parse("192.168.1.1"),     0xC0A80101, "ipv4 gateway");
    assert_eq(taar_ipv4_parse("255.255.255.255"), 0xFFFFFFFF, "ipv4 broadcast");
    assert_eq(taar_ipv4_parse("10.0.2.15"),       0x0A00020F, "ipv4 slirp guest");
    # Rejection cases.
    assert_eq(taar_ipv4_parse("256.0.0.0"),  TAAR_IPV4_PARSE_FAIL, "ipv4 octet > 255");
    assert_eq(taar_ipv4_parse("1.2.3"),      TAAR_IPV4_PARSE_FAIL, "ipv4 only 3 octets");
    assert_eq(taar_ipv4_parse("1.2.3.4.5"),  TAAR_IPV4_PARSE_FAIL, "ipv4 5 octets");
    assert_eq(taar_ipv4_parse("1.2..4"),     TAAR_IPV4_PARSE_FAIL, "ipv4 empty segment");
    assert_eq(taar_ipv4_parse(""),           TAAR_IPV4_PARSE_FAIL, "ipv4 empty string");
    assert_eq(taar_ipv4_parse("1.2.3.4 "),   TAAR_IPV4_PARSE_FAIL, "ipv4 trailing space");
    assert_eq(taar_ipv4_parse("1234.0.0.0"), TAAR_IPV4_PARSE_FAIL, "ipv4 4-digit octet");
    assert_eq(taar_ipv4_parse("1.2.3.4\n"),  TAAR_IPV4_PARSE_FAIL, "ipv4 trailing newline");
    assert_eq(taar_ipv4_parse("0x7f.0.0.1"), TAAR_IPV4_PARSE_FAIL, "ipv4 hex rejected");
    assert_eq(taar_ipv4_parse(".1.2.3"),     TAAR_IPV4_PARSE_FAIL, "ipv4 leading dot");
    assert_eq(taar_ipv4_parse("1.2.3.4."),   TAAR_IPV4_PARSE_FAIL, "ipv4 trailing dot");
    # Leading zeros are refused (0.8.2): inet_aton(3) reads "010" as octal 8
    # and a decimal reader as 10, so the string is ambiguous. A lone "0" is an
    # octet; any longer octet may not start with one.
    assert_eq(taar_ipv4_parse("010.1.1.1"),  TAAR_IPV4_PARSE_FAIL, "ipv4 leading zero refused");
    assert_eq(taar_ipv4_parse("1.2.3.04"),   TAAR_IPV4_PARSE_FAIL, "... in any octet");
    assert_eq(taar_ipv4_parse("00.0.0.0"),   TAAR_IPV4_PARSE_FAIL, "ipv4 double zero refused");
    assert_eq(taar_ipv4_parse("0.0.0.0"),    0x00000000, "a lone 0 is an octet");
    assert_eq(taar_ipv4_parse("10.0.100.200"), 0x0A0064C8, "zeros after the first digit are fine");
    return 0;
}

# === IPv4 format — round-trip ===
fn test_ipv4_format() {
    test_group("ipv4_format");
    var b = alloc(16);
    var n = taar_ipv4_format_to_buf(0x7F000001, b);
    store8(b + n, 0);
    assert_eq(streq(b, "127.0.0.1"), 1, "ipv4 format loopback");
    n = taar_ipv4_format_to_buf(0xFFFFFFFF, b);
    store8(b + n, 0);
    assert_eq(streq(b, "255.255.255.255"), 1, "ipv4 format broadcast");
    n = taar_ipv4_format_to_buf(0xC0A80101, b);
    store8(b + n, 0);
    assert_eq(streq(b, "192.168.1.1"), 1, "ipv4 format gateway");
    # Round-trip: parse(format(x)) == x.
    n = taar_ipv4_format_to_buf(0x08080808, b);
    store8(b + n, 0);
    assert_eq(taar_ipv4_parse(b), 0x08080808, "ipv4 round-trip 8.8.8.8");
    return 0;
}

# === socket: sockaddr_in builder (pure; the syscalls smoke against a live host) ===
fn test_sockaddr() {
    test_group("sockaddr");
    var sa = alloc(16);
    _taar_fill_sockaddr(sa, 0xC0A80101, 53);   # 192.168.1.1 : 53
    assert_eq(load8(sa + 0), 2,   "AF_INET low byte");
    assert_eq(load8(sa + 1), 0,   "AF_INET high byte");
    assert_eq(load8(sa + 2), 0,   "port hi (53>>8)");
    assert_eq(load8(sa + 3), 53,  "port lo");
    assert_eq(load8(sa + 4), 192, "addr octet 0");
    assert_eq(load8(sa + 5), 168, "addr octet 1");
    assert_eq(load8(sa + 6), 1,   "addr octet 2");
    assert_eq(load8(sa + 7), 1,   "addr octet 3");
    # a port spanning both bytes: 443 = 0x01BB
    _taar_fill_sockaddr(sa, 0x08080808, 443);
    assert_eq(load8(sa + 2), 1,   "port hi (443>>8 = 1)");
    assert_eq(load8(sa + 3), 187, "port lo (443 & 0xFF = 187)");
    return 0;
}

# === dns: wire framing (pure; the live resolve is a smoke) ===
fn test_dns_encode() {
    test_group("dns-encode");
    var out = alloc(64);
    var n = _taar_dns_encode_name("example.com", out);
    assert_eq(n, 13, "encode len (example.com)");
    assert_eq(load8(out + 0), 7, "label1 length = 7");
    assert_eq(load8(out + 1), 101, "label1[0] = 'e'");
    assert_eq(load8(out + 8), 3, "label2 length = 3");
    assert_eq(load8(out + 12), 0, "root label terminator");
}

# === dns: query builder (header id / RD flag / qdcount) ===
fn test_dns_build() {
    test_group("dns-build");
    var qb = alloc(300);
    var ql = _taar_dns_build_query(qb, 0xABCD, "a.bc");
    assert_eq(ql, 22, "query len for a.bc (12 + 6 + 4)");
    assert_eq(load8(qb + 0), 171, "id hi byte (0xAB)");
    assert_eq(load8(qb + 1), 205, "id lo byte (0xCD)");
    assert_eq(load8(qb + 2), 1, "RD flag hi byte (0x01)");
    assert_eq(load8(qb + 5), 1, "qdcount lo = 1");
}

# Hand-build a minimal A response (example.com -> 93.184.216.34). Returns length.
fn _canned_a_response(buf): i64 {
    _taar_dns_store_u16(buf, 0, 0x1234);   # id
    _taar_dns_store_u16(buf, 2, 0x8180);   # QR|RD|RA, rcode NOERROR
    _taar_dns_store_u16(buf, 4, 1);        # qdcount
    _taar_dns_store_u16(buf, 6, 1);        # ancount
    _taar_dns_store_u16(buf, 8, 0);
    _taar_dns_store_u16(buf, 10, 0);
    var n = _taar_dns_encode_name("example.com", buf + 12);
    var off = 12 + n;
    _taar_dns_store_u16(buf, off, 1); off = off + 2;   # qtype A
    _taar_dns_store_u16(buf, off, 1); off = off + 2;   # qclass IN
    store8(buf + off, 0xC0); store8(buf + off + 1, 0x0C); off = off + 2;   # answer name ptr -> 12
    _taar_dns_store_u16(buf, off, 1); off = off + 2;   # type A
    _taar_dns_store_u16(buf, off, 1); off = off + 2;   # class IN
    # ttl 3600 (0x00000E10)
    store8(buf + off, 0); store8(buf + off + 1, 0);
    store8(buf + off + 2, 0x0E); store8(buf + off + 3, 0x10); off = off + 4;
    _taar_dns_store_u16(buf, off, 4); off = off + 2;   # rdlength
    # rdata 93.184.216.34
    store8(buf + off, 93); store8(buf + off + 1, 184);
    store8(buf + off + 2, 216); store8(buf + off + 3, 34); off = off + 4;
    return off;
}

# === dns: A-record parse over a canned NOERROR response ===
fn test_dns_parse_a() {
    test_group("dns-parse-a");
    var buf = alloc(128);
    var len = _canned_a_response(buf);
    assert_eq(_taar_dns_hdr_ancount(buf), 1, "ancount = 1");
    assert_eq(_taar_dns_hdr_rcode(buf), 0, "rcode NOERROR");
    assert_eq(_taar_dns_first_a(buf, len), 0x5DB8D822, "A record 93.184.216.34");
}

# === dns: reply acceptance (RFC 5452 binding) ===
fn test_dns_reply_match() {
    test_group("dns-reply-match");
    var q = alloc(300);
    var ql = _taar_dns_build_query(q, 0x1234, "example.com");
    var r = alloc(256);
    var rl = _canned_a_response(r);          # same id + same qname
    assert_eq(ql, 29, "query len (12 + 13 + 4)");
    assert_eq(_taar_dns_hdr_qr(q), 0, "outbound query has QR=0");
    assert_eq(_taar_dns_hdr_qr(r), 1, "response has QR=1");
    assert_eq(_taar_dns_hdr_tc(r), 0, "response not truncated");
    assert_eq(_taar_dns_same_question(q, ql, r, rl), 1, "echoed question matches");
    # A reply that carries our id but answers a different name must be refused.
    store8(r + 13, 120);                      # 'e' -> 'x' in the echoed qname
    assert_eq(_taar_dns_same_question(q, ql, r, rl), 0, "altered qname refused");
    store8(r + 13, 101);                      # restore
    assert_eq(_taar_dns_same_question(q, ql, r, rl), 1, "restored qname matches");
    # The name compares without case; only A-Z fold.
    store8(r + 13, 69);                       # 'e' -> 'E'
    store8(r + 21, 67);                       # 'c' of "com" -> 'C'
    assert_eq(_taar_dns_same_question(q, ql, r, rl), 1, "echo in another case accepted");
    store8(r + 13, 101); store8(r + 21, 99);
    # Only A-Z fold: '{' (0x7B) is not '[' (0x5B), though they too are 32 apart.
    store8(q + 13, 0x7B); store8(r + 13, 0x5B);
    assert_eq(_taar_dns_same_question(q, ql, r, rl), 0, "only letters fold");
    store8(q + 13, 101); store8(r + 13, 101);
    # QTYPE / QCLASS must match exactly (the last four bytes of the question).
    store8(r + ql - 3, 0x41);                 # QTYPE 0x0041, not A
    assert_eq(_taar_dns_same_question(q, ql, r, rl), 0, "QTYPE altered refused");
    # Were the whole question folded, a QTYPE byte 0x41 ('A') would match 0x61.
    store8(q + ql - 3, 0x41); store8(r + ql - 3, 0x61);
    assert_eq(_taar_dns_same_question(q, ql, r, rl), 0, "QTYPE never folds");
    store8(q + ql - 3, 1); store8(r + ql - 3, 1);
    assert_eq(_taar_dns_same_question(q, ql, r, rl), 1, "restored question matches");
    # Too short to even contain the question we asked.
    assert_eq(_taar_dns_same_question(q, ql, r, 20), 0, "runt reply refused");
    return 0;
}

# === dns: hostile wire input (the parser sees attacker-chosen bytes) ===
fn test_dns_hostile() {
    test_group("dns-hostile");
    var m = alloc(64);
    var i = 0;
    while (i < 64) { store8(m + i, 0); i = i + 1; }

    # Valid backward pointer is the control: name at 12, pointer to it at 20.
    store8(m + 12, 1); store8(m + 13, 97); store8(m + 14, 0);   # "a."
    store8(m + 20, 0xC0); store8(m + 21, 0x0C);
    assert_eq(_taar_dns_skip_name(m, 64, 20), 22, "backward pointer accepted");

    # Self-referential pointer — the classic decompression loop.
    store8(m + 12, 0xC0); store8(m + 13, 0x0C);
    assert_eq(_taar_dns_skip_name(m, 64, 12), 0, "self-pointer refused");
    # Forward pointer (would allow unbounded advance).
    store8(m + 13, 0x20);
    assert_eq(_taar_dns_skip_name(m, 64, 12), 0, "forward pointer refused");
    # Pointer target past the end of the message.
    store8(m + 13, 0xFF);
    assert_eq(_taar_dns_skip_name(m, 64, 12), 0, "out-of-range pointer refused");
    # 0x40/0x80 are reserved label-length prefixes, not lengths. Use a buffer
    # big enough that treating 0x40 as the length 64 would still land in bounds
    # — otherwise the end-of-message check masks the prefix check.
    var big = alloc(256);
    var k = 0;
    while (k < 256) { store8(big + k, 0); k = k + 1; }
    store8(big + 12, 0x40);                   # 0b01xxxxxx: reserved, not len 64
    assert_eq(_taar_dns_skip_name(big, 256, 12), 0, "reserved label prefix refused");
    store8(big + 12, 63);                     # 63 is the largest legal label
    assert_eq(_taar_dns_skip_name(big, 256, 12), 77, "max-length label accepted");
    # Label that runs off the end of the buffer.
    store8(m + 12, 60);
    assert_eq(_taar_dns_skip_name(m, 20, 12), 0, "label past end refused");
    # Every pointer here goes backward, so only the hop budget stops it: the
    # label at 12 walks forward to 14, whose pointer jumps back to 12, forever.
    store8(m + 12, 1); store8(m + 13, 97);
    store8(m + 14, 0xC0); store8(m + 15, 12);
    assert_eq(_taar_dns_skip_name(m, 64, 14), 0, "label + back-pointer loop refused");

    # An A record whose rdlength claims more bytes than the message holds.
    var b = alloc(128);
    var len = _canned_a_response(b);
    assert_eq(_taar_dns_first_a(b, len), 0x5DB8D822, "well-formed A parses");
    # rdata that runs past the declared end of the message. rdlength still says
    # 4 (so the A-record branch IS entered) but the message is two bytes short —
    # only the rdata+rdlen bounds check stops the over-read.
    assert_eq(_taar_dns_first_a(b, len - 2), 0 - 1, "rdata past message end refused");
    # An A record whose rdlength is not 4 is not a v4 address; skip it.
    _taar_dns_store_u16(b, len - 6, 0xFFFF);
    assert_eq(_taar_dns_first_a(b, len), 0 - 1, "non-4 rdlength for A skipped");
    # Header-only truncation: the question can no longer be skipped.
    assert_eq(_taar_dns_first_a(b, 13), 0 - 1, "truncated message refused");
    return 0;
}

# === dns: name encoding edge cases ===
fn test_dns_encode_edges() {
    test_group("dns-encode-edges");
    var o1 = alloc(300);
    var o2 = alloc(300);
    var n1 = _taar_dns_encode_name("example.com", o1);
    var n2 = _taar_dns_encode_name("example.com.", o2);
    assert_eq(n2, n1, "trailing dot encodes identically");
    # An empty name used to encode as the bare root label, which build_query
    # turned into a well-formed query for "." — now refused outright.
    assert_eq(_taar_dns_encode_name("", o1), 0, "empty name refused");
    assert_eq(_taar_dns_build_query(o1, 1, ""), 0, "empty-name query refused");
    # Empty interior label.
    assert_eq(_taar_dns_encode_name("a..b", o1), 0, "empty interior label refused");
    return 0;
}

# === resolve: offline guard paths (no socket is opened for any of these) ===
fn test_resolve_guards() {
    test_group("resolve-guards");
    assert_eq(taar_resolve_ipv4(0), 0 - 1, "null host refused");
    assert_eq(taar_resolve_ipv4(""), 0 - 1, "empty host refused");
    # A dotted-quad literal short-circuits before any DNS traffic.
    assert_eq(taar_resolve_ipv4("127.0.0.1"), 0x7F000001, "literal short-circuits");
    assert_eq(taar_resolve_ipv4("8.8.8.8"), 0x08080808, "literal short-circuits (2)");
    return 0;
}

# === dns: TCP framing (RFC 1035 4.2.2 length prefix) ===
fn test_dns_tcp_frame() {
    test_group("dns-tcp-frame");
    var q = alloc(300);
    var ql = _taar_dns_build_query(q, 0x1234, "example.com");
    var out = alloc(320);
    var fl = _taar_dns_tcp_frame(q, ql, out);
    assert_eq(fl, ql + 2, "framed length = query + 2-byte prefix");
    assert_eq(load8(out + 0), (ql >> 8) & 0xFF, "prefix hi byte");
    assert_eq(load8(out + 1), ql & 0xFF, "prefix lo byte");
    # The body must be copied verbatim after the prefix.
    assert_eq(load8(out + 2), load8(q + 0), "body byte 0 copied");
    assert_eq(load8(out + 2 + ql - 1), load8(q + ql - 1), "body last byte copied");
    # A 512-byte-plus message is legal over TCP; only 0 and >0xFFFF are not.
    assert_eq(_taar_dns_tcp_frame(q, 0, out), 0, "zero-length refused");
    assert_eq(_taar_dns_tcp_frame(q, 0x10000, out), 0, "over-65535 refused");
    return 0;
}

# === dns: shared reply-acceptance gate (used by both UDP and the TCP retry) ===
fn test_dns_reply_ok() {
    test_group("dns-reply-ok");
    var q = alloc(300);
    var ql = _taar_dns_build_query(q, 0x1234, "example.com");
    var r = alloc(256);
    var rl = _canned_a_response(r);
    assert_eq(_taar_dns_reply_ok(q, ql, r, rl, 0x1234), 1, "good reply accepted");
    assert_eq(_taar_dns_reply_ok(q, ql, r, rl, 0x1235), 0, "wrong id refused");
    assert_eq(_taar_dns_reply_ok(q, ql, r, 8, 0x1234), 0, "sub-header runt refused");
    # QR=0 — an unsolicited query, not an answer.
    _taar_dns_store_u16(r, 2, 0x0180);
    assert_eq(_taar_dns_reply_ok(q, ql, r, rl, 0x1234), 0, "QR=0 refused");
    _taar_dns_store_u16(r, 2, 0x8180);
    # QDCOUNT != 1.
    _taar_dns_store_u16(r, 4, 2);
    assert_eq(_taar_dns_reply_ok(q, ql, r, rl, 0x1234), 0, "qdcount != 1 refused");
    _taar_dns_store_u16(r, 4, 1);
    # Question echoed back altered.
    store8(r + 13, 120);
    assert_eq(_taar_dns_reply_ok(q, ql, r, rl, 0x1234), 0, "altered question refused");
    store8(r + 13, 101);
    assert_eq(_taar_dns_reply_ok(q, ql, r, rl, 0x1234), 1, "restored reply accepted");
    # OPCODE must be QUERY (0): a STATUS or NOTIFY "reply" is not an answer.
    _taar_dns_store_u16(r, 2, 0x9180);            # QR | opcode 2 (STATUS) | RD RA
    assert_eq(_taar_dns_reply_ok(q, ql, r, rl, 0x1234), 0, "non-QUERY opcode refused");
    _taar_dns_store_u16(r, 2, 0x8180);
    # TC is NOT an acceptance failure — it triggers the TCP retry instead.
    _taar_dns_store_u16(r, 2, 0x8380);
    assert_eq(_taar_dns_hdr_tc(r), 1, "TC bit read back");
    assert_eq(_taar_dns_reply_ok(q, ql, r, rl, 0x1234), 1, "TC reply still accepted");
    return 0;
}

# === socket: recv return contract (timeout must not look like a clean close) ===
#
# Uses an AF_UNIX socketpair rather than the network: no peer ever writes, so
# the deadline is guaranteed to expire, and closing the far end gives a real
# clean close to compare against. Host-only, like the rest of this suite.
#
# This is the invariant the AGNOS backend was violating until 0.5.0 — it
# returned 0 for both, so a stalled peer was indistinguishable from a finished
# response. The Linux arm always got this right; the assertion pins both.
fn test_socket_recv_contract() {
    test_group("socket-recv-contract");
    assert_eq(TAAR_ERR_TIMEOUT, 0 - 11, "timeout constant is -EAGAIN");

    var fds[16];
    store64(&fds, 0);
    var r = sys_socketpair(1, 1, 0, &fds);        # AF_UNIX, SOCK_STREAM
    assert_eq(r, 0, "socketpair available");
    var a = load32(&fds);
    var b = load32(&fds + 4);
    var buf[8];

    taar_tcp_set_timeout_ms(a, 200);
    var n = taar_tcp_recv(a, &buf, 8);            # nothing was ever written
    assert_eq(n, TAAR_ERR_TIMEOUT, "deadline expiry returns TAAR_ERR_TIMEOUT");

    sys_close(b);                                  # now a genuine clean close
    var m = taar_tcp_recv(a, &buf, 8);
    assert_eq(m, 0, "peer close returns 0");
    sys_close(a);
    return 0;
}

# Copy a NUL-terminated literal into `dst` (no terminator written). Returns
# its length — resolv.conf text is parsed by (buf, len), as it comes off disk.
fn _t_put(dst, s): i64 {
    var i = 0;
    while (load8(s + i) != 0) { store8(dst + i, load8(s + i)); i = i + 1; }
    return i;
}

var _t_cfg: i64[6];            # a resolver config block (48 bytes)

# _taar_resolv_parse into a scratch config: the first nameserver when the text
# has a usable one, else the parse result (0 = none named, -1 = none usable).
fn _t_first(b, n): i64 {
    var r = _taar_resolv_parse(b, n, &_t_cfg);
    if (r > 0) { return load64(&_t_cfg); }
    return r;
}

# _taar_resolv_choose into a scratch config: the first nameserver chosen, or
# 0 when the resolve must fail closed.
fn _t_choose(ksrv, b, n, cap): i64 {
    if (_taar_resolv_choose(ksrv, b, n, cap, &_t_cfg) <= 0) { return 0; }
    return load64(&_t_cfg);
}

# === resolv.conf: the parser sees file contents DHCP clients write ===
fn test_resolv_parse() {
    test_group("resolv-parse");
    var b = alloc(512);
    var n = _t_put(b, "nameserver 192.168.1.1\n");
    assert_eq(_t_first(b, n), 0xC0A80101, "plain nameserver");
    n = _t_put(b, "# managed\n; legacy comment\nsearch lan\n\n  \tnameserver\t10.0.0.53  # trailing\n");
    assert_eq(_t_first(b, n), 0x0A000035, "comments, blank line, tab separator");
    n = _t_put(b, "nameserver 1.1.1.1");
    assert_eq(_t_first(b, n), 0x01010101, "no trailing newline");
    n = _t_put(b, "nameserver 9.9.9.9\nnameserver 1.1.1.1\n");
    assert_eq(_t_first(b, n), 0x09090909, "first nameserver is asked first");
    n = _t_put(b, "nameserver ::1\nnameserver 192.0.2.7\n");
    assert_eq(_t_first(b, n), 0xC0000207, "IPv6 entry skipped for a later IPv4");
    # CRLF files (written on, or copied from, Windows) end each token with a CR.
    n = _t_put(b, "nameserver 1.2.3.4\r\n");
    assert_eq(_t_first(b, n), 0x01020304, "CRLF line ending");
    # 0.0.0.0 used to stop the scan as "found" and then read as "none".
    n = _t_put(b, "nameserver 0.0.0.0\nnameserver 192.0.2.9\n");
    assert_eq(_t_first(b, n), 0xC0000209, "0.0.0.0 skipped for a later server");
    # The keyword must be a whole word.
    n = _t_put(b, "nameservers 8.8.4.4\n");
    assert_eq(_t_first(b, n), 0, "nameserverS is not the keyword");
    # 0 = the file names no nameserver at all.
    n = _t_put(b, "search lan\noptions edns0\n");
    assert_eq(_t_first(b, n), 0, "no nameserver line");
    assert_eq(_t_first(b, 0), 0, "empty file");
    n = _t_put(b, "nameserver\n");
    assert_eq(_t_first(b, n), 0, "keyword with no address is not an entry");
    # -1 = it names nameservers, none of them usable over IPv4. Distinct from 0,
    # because the caller must not treat a configured resolver as a missing one.
    n = _t_put(b, "nameserver ::1\nnameserver fe80::1%eth0\n");
    assert_eq(_t_first(b, n), 0 - 1, "IPv6-only file is configured, not empty");
    n = _t_put(b, "nameserver 0.0.0.0\n");
    assert_eq(_t_first(b, n), 0 - 1, "0.0.0.0 is not a usable server");
    n = _t_put(b, "nameserver 10.0.0.256\n");
    assert_eq(_t_first(b, n), 0 - 1, "malformed address is not usable");
    n = _t_put(b, "nameserver 1111111111111111111111111111111111111111111111111111111111111111111\n");
    assert_eq(_t_first(b, n), 0 - 1, "over-long token refused, not copied");
    return 0;
}

# === resolv: the discovery decision (kernel lease -> file -> fallback) ===
fn test_resolv_choose() {
    test_group("resolv-choose");
    var b = alloc(512);
    var n = _t_put(b, "nameserver 192.168.1.1\n");
    assert_eq(_t_choose(0x0A000001, b, n, 512), 0x0A000001, "kernel-leased server wins");
    assert_eq(_t_choose(0, b, n, 512), 0xC0A80101, "file server used");
    assert_eq(_taar_plat_dns_fallback(), 0x7F000001, "Linux fallback is 127.0.0.1, as glibc and musl");
    assert_eq(_t_choose(0, b, 0 - 2, 512), _taar_plat_dns_fallback(), "no file: the fallback");
    assert_eq(_t_choose(0, b, 0 - 13, 512), _taar_plat_dns_fallback(), "unreadable file (EACCES): the fallback");
    n = _t_put(b, "search lan\n");
    assert_eq(_t_choose(0, b, n, 512), _taar_plat_dns_fallback(), "no nameserver: the fallback");
    # A host whose resolv.conf names only IPv6 resolvers has a DNS config taar
    # cannot use. Sending its lookups to 8.8.8.8 instead would bypass the
    # resolver the host chose (VPN, split-horizon, filtering) and disclose every
    # hostname to a third party. Fail closed.
    n = _t_put(b, "nameserver ::1\n");
    assert_eq(_t_choose(0, b, n, 512), 0, "IPv6-only: fail closed, no public fallback");
    # A read that filled the buffer may have cut the last line mid-address:
    # "nameserver 10.0.0.12" read as "nameserver 10.0.0.1" is a valid but WRONG
    # server. The partial line is dropped and, with nothing complete left, the
    # resolve fails closed rather than guessing.
    n = _t_put(b, "# big file\nnameserver 10.0.0.12\n");
    var cut = n - 2;                               # ends "...10.0.0.1"
    assert_eq(_t_choose(0, b, cut, cut), 0, "cut nameserver line: not used, fail closed");
    n = _t_put(b, "nameserver 172.16.0.1\nnameserver 10.0.0.12\n");
    cut = n - 2;
    assert_eq(_t_choose(0, b, cut, cut), 0xAC100001, "complete line before the cut still used");
    return 0;
}

# === resolv.conf: several nameservers, and the options that pace them ===
fn test_resolv_conf() {
    test_group("resolv-conf");
    var b = alloc(512);
    var c = &_t_cfg;
    var n = _t_put(b, "nameserver 10.0.0.1\nnameserver 10.0.0.2\nnameserver 10.0.0.3\nnameserver 10.0.0.4\n");
    assert_eq(_taar_resolv_parse(b, n, c), 3, "three nameservers used, the fourth ignored (glibc MAXNS)");
    assert_eq(load64(c), 0x0A000001, "first in file order");
    assert_eq(load64(c + 8), 0x0A000002, "second in file order");
    assert_eq(load64(c + 16), 0x0A000003, "third in file order");
    assert_eq(load64(c + _TAAR_RESOLV_CFG_COUNT), 3, "count stored");
    # Unusable entries do not use up the three.
    n = _t_put(b, "nameserver ::1\nnameserver 10.0.0.9\nnameserver 0.0.0.0\nnameserver 10.0.0.8\n");
    assert_eq(_taar_resolv_parse(b, n, c), 2, "IPv6 and 0.0.0.0 skipped, not counted");
    assert_eq(load64(c + 8), 0x0A000008, "the IPv4 after them is second");
    n = _t_put(b, "nameserver ::1\nnameserver ::2\nnameserver ::3\nnameserver 192.0.2.1\n");
    assert_eq(_t_first(b, n), 0xC0000201, "three IPv6 entries do not hide a fourth IPv4 one");
    # Defaults: glibc's 5 s and 2 attempts.
    n = _t_put(b, "nameserver 10.0.0.1\n");
    _taar_resolv_parse(b, n, c);
    assert_eq(load64(c + _TAAR_RESOLV_CFG_TIMEOUT), 5000, "default timeout 5 s");
    assert_eq(load64(c + _TAAR_RESOLV_CFG_ATTEMPTS), 2, "default attempts 2");
    # options, among others taar ignores.
    n = _t_put(b, "nameserver 10.0.0.1\noptions edns0 timeout:2 rotate attempts:3 trust-ad\n");
    _taar_resolv_parse(b, n, c);
    assert_eq(load64(c + _TAAR_RESOLV_CFG_TIMEOUT), 2000, "options timeout:2");
    assert_eq(load64(c + _TAAR_RESOLV_CFG_ATTEMPTS), 3, "options attempts:3");
    n = _t_put(b, "options timeout:1\r\nnameserver 10.0.0.1\r\noptions attempts:4\r\n");
    _taar_resolv_parse(b, n, c);
    assert_eq(load64(c + _TAAR_RESOLV_CFG_TIMEOUT), 1000, "options before the nameservers, CRLF");
    assert_eq(load64(c + _TAAR_RESOLV_CFG_ATTEMPTS), 4, "a second options line adds to the first");
    n = _t_put(b, "options timeout:2\noptions timeout:7\n");
    _taar_resolv_parse(b, n, c);
    assert_eq(load64(c + _TAAR_RESOLV_CFG_TIMEOUT), 7000, "a later timeout overrides");
    # Clamped as glibc clamps, with 0 raised to 1.
    n = _t_put(b, "options timeout:0 attempts:0\n");
    _taar_resolv_parse(b, n, c);
    assert_eq(load64(c + _TAAR_RESOLV_CFG_TIMEOUT), 1000, "timeout:0 raised to 1 s");
    assert_eq(load64(c + _TAAR_RESOLV_CFG_ATTEMPTS), 1, "attempts:0 raised to 1");
    n = _t_put(b, "options timeout:99 attempts:9\n");
    _taar_resolv_parse(b, n, c);
    assert_eq(load64(c + _TAAR_RESOLV_CFG_TIMEOUT), 30000, "timeout capped at 30 s");
    assert_eq(load64(c + _TAAR_RESOLV_CFG_ATTEMPTS), 5, "attempts capped at 5");
    # Malformed values leave the defaults.
    n = _t_put(b, "options timeout: timeout:2s attempts:x timeout:1234567 attempts:-1\n");
    _taar_resolv_parse(b, n, c);
    assert_eq(load64(c + _TAAR_RESOLV_CFG_TIMEOUT), 5000, "malformed timeouts ignored");
    assert_eq(load64(c + _TAAR_RESOLV_CFG_ATTEMPTS), 2, "malformed attempts ignored");
    n = _t_put(b, "optionsx timeout:1\n#options timeout:1\noptions\ttimeout:3\n");
    _taar_resolv_parse(b, n, c);
    assert_eq(load64(c + _TAAR_RESOLV_CFG_TIMEOUT), 3000, "keyword must be a whole word; tab separates");
    # The fallback keeps the file's options; a kernel lease takes the defaults.
    n = _t_put(b, "options timeout:3\n");
    assert_eq(_taar_resolv_choose(0, b, n, 512, c), 1, "no nameserver: one fallback server");
    assert_eq(load64(c), _taar_plat_dns_fallback(), "... the fallback");
    assert_eq(load64(c + _TAAR_RESOLV_CFG_TIMEOUT), 3000, "... paced by the file's options");
    assert_eq(_taar_resolv_choose(0x0A000001, b, n, 512, c), 1, "kernel lease: one server");
    assert_eq(load64(c + _TAAR_RESOLV_CFG_TIMEOUT), 5000, "... with the default timeout");
    n = _t_put(b, "nameserver 10.0.0.1\nnameserver 10.0.0.2\n");
    assert_eq(_taar_resolv_choose(0, b, n, 512, c), 2, "file servers: all of them");
    return 0;
}

# === dns: RFC 1035 2.3.4 size limits on the name we send ===
fn test_dns_encode_bounds() {
    test_group("dns-encode-bounds");
    var name = alloc(400);
    var out = alloc(400);
    var i = 0;
    while (i < 63) { store8(name + i, 97); i = i + 1; }
    store8(name + 63, 0);
    assert_eq(_taar_dns_encode_name(name, out), 65, "63-byte label accepted");
    store8(name + 63, 97); store8(name + 64, 0);
    assert_eq(_taar_dns_encode_name(name, out), 0, "64-byte label refused");
    # 63.63.63.61 = 253 characters = a 255-octet wire name, the maximum.
    var p = 0;
    var lab = 0;
    while (lab < 4) {
        var w = 63;
        if (lab == 3) { w = 61; }
        var k = 0;
        while (k < w) { store8(name + p, 98); p = p + 1; k = k + 1; }
        if (lab < 3) { store8(name + p, 46); p = p + 1; }
        lab = lab + 1;
    }
    store8(name + p, 0);
    assert_eq(p, 253, "test name is 253 characters");
    assert_eq(_taar_dns_encode_name(name, out), 255, "255-octet wire name accepted");
    store8(name + p, 98); store8(name + p + 1, 0);
    assert_eq(_taar_dns_encode_name(name, out), 0, "256-octet wire name refused");
    # Memory safety, not just the verdict: the end-of-name length check alone
    # would also return 0 for a 390-character name, after writing all of it.
    # The in-loop check must stop the copy at 256 bytes — in taar_resolve_ipv4
    # `out` is qbuf + 12 inside a 300-byte stack buffer.
    var big = alloc(400);
    i = 0;
    while (i < 390) { store8(big + i, 99); i = i + 1; }
    store8(big + 390, 0);
    var canary = alloc(512);
    i = 0;
    while (i < 512) { store8(canary + i, 0xA5); i = i + 1; }
    assert_eq(_taar_dns_encode_name(big, canary), 0, "390-character name refused");
    var clean = 1;
    i = 257;
    while (i < 512) { if (load8(canary + i) != 0xA5) { clean = 0; } i = i + 1; }
    assert_eq(clean, 1, "refused name wrote nothing past 257 bytes");
    return 0;
}

# === dns: only class-IN A records answer an IN question ===
fn test_dns_answer_class() {
    test_group("dns-answer-class");
    var b = alloc(128);
    var len = _canned_a_response(b);
    assert_eq(_taar_dns_first_a(b, len), 0x5DB8D822, "class IN A accepted");
    # The answer's class word sits 6 bytes before its rdata's TTL+rdlength:
    # [type 2][class 2][ttl 4][rdlength 2][rdata 4] ends the message.
    _taar_dns_store_u16(b, len - 12, 3);          # CH (chaos)
    assert_eq(_taar_dns_first_a(b, len), 0 - 1, "class CH A record not taken as an address");
    return 0;
}

# --- a reply builder for the owner-name tests ---

# Start a NOERROR reply to `qname` in `buf` (512 bytes, zeroed): id 0x1234,
# one question at offset 12, no answers yet. Returns the offset past the question.
fn _t_msg(buf, qname): i64 {
    var i = 0;
    while (i < 512) { store8(buf + i, 0); i = i + 1; }
    _taar_dns_store_u16(buf, 0, 0x1234);
    _taar_dns_store_u16(buf, 2, 0x8180);
    _taar_dns_store_u16(buf, 4, 1);
    var off = 12 + _taar_dns_encode_name(qname, buf + 12);
    _taar_dns_store_u16(buf, off, _TAAR_DNS_TYPE_A);
    _taar_dns_store_u16(buf, off + 2, _TAAR_DNS_CLASS_IN);
    return off + 4;
}

# Append an answer's fixed part after an owner already written at `off`: type
# `t`, class IN, ttl 60, rdlength `rdlen`. Bumps ANCOUNT. Returns the rdata offset.
fn _t_rr(buf, off, t, rdlen): i64 {
    _taar_dns_store_u16(buf, off, t);
    _taar_dns_store_u16(buf, off + 2, _TAAR_DNS_CLASS_IN);
    _taar_dns_store_u16(buf, off + 4, 0);
    _taar_dns_store_u16(buf, off + 6, 60);
    _taar_dns_store_u16(buf, off + 8, rdlen);
    _taar_dns_store_u16(buf, 6, _taar_dns_hdr_ancount(buf) + 1);
    return off + 10;
}

# Write a compression pointer to `target` at `off`. Returns off + 2.
fn _t_ptr(buf, off, target): i64 {
    store8(buf + off, 0xC0 | (target >> 8));
    store8(buf + off + 1, target & 0xFF);
    return off + 2;
}

# Append an A record for the name at `owner` (a pointer) -> 10.0.0.x. Returns the end.
fn _t_a(buf, off, owner, x): i64 {
    var rd = _t_rr(buf, _t_ptr(buf, off, owner), _TAAR_DNS_TYPE_A, 4);
    store8(buf + rd, 10); store8(buf + rd + 1, 0); store8(buf + rd + 2, 0); store8(buf + rd + 3, x);
    return rd + 4;
}

# Append an A record whose owner is the literal name `owner` -> 10.0.0.x. Returns the end.
fn _t_a_lit(buf, off, owner, x): i64 {
    var o = off + _taar_dns_encode_name(owner, buf + off);
    var rd = _t_rr(buf, o, _TAAR_DNS_TYPE_A, 4);
    store8(buf + rd, 10); store8(buf + rd + 1, 0); store8(buf + rd + 2, 0); store8(buf + rd + 3, x);
    return rd + 4;
}

# Append a CNAME from the name at `owner` (a pointer) to the literal name
# `target`. The target's offset is the returned end minus its encoded length;
# _t_cname_at returns it directly. Returns the end.
var _t_last_cname = 0;
fn _t_cname(buf, off, owner, target): i64 {
    var tmp[300];
    var n = _taar_dns_encode_name(target, &tmp);
    var rd = _t_rr(buf, _t_ptr(buf, off, owner), _TAAR_DNS_TYPE_CNAME, n);
    var i = 0;
    while (i < n) { store8(buf + rd + i, load8(&tmp + i)); i = i + 1; }
    _t_last_cname = rd;
    return rd + n;
}

# === dns: an answer counts only for the name asked, or its CNAME chain ===
fn test_dns_owner() {
    test_group("dns-owner");
    var b = alloc(512);
    var q = 12;                                   # the question's name
    var e = _t_msg(b, "example.com");
    e = _t_a(b, e, q, 1);
    assert_eq(_taar_dns_first_a(b, e), 0x0A000001, "A for the question (pointer owner)");
    e = _t_msg(b, "example.com");
    e = _t_a_lit(b, e, "example.com", 2);
    assert_eq(_taar_dns_first_a(b, e), 0x0A000002, "A for the question (literal owner)");
    e = _t_msg(b, "example.com");
    e = _t_a_lit(b, e, "EXAMPLE.Com", 3);
    assert_eq(_taar_dns_first_a(b, e), 0x0A000003, "owner compared without case (RFC 4343)");

    # Records for some other name are not the answer, wherever they sit.
    e = _t_msg(b, "example.com");
    e = _t_a_lit(b, e, "evil.test", 66);
    e = _t_a(b, e, q, 4);
    assert_eq(_taar_dns_first_a(b, e), 0x0A000004, "an A for another name first is skipped");
    e = _t_msg(b, "example.com");
    e = _t_a_lit(b, e, "evil.test", 66);
    assert_eq(_taar_dns_first_a(b, e), 0 - 1, "an A for another name alone is no answer");
    e = _t_msg(b, "example.com");
    e = _t_a_lit(b, e, "example.co", 66);
    e = _t_a_lit(b, e, "a.example.com", 67);
    e = _t_a_lit(b, e, "example.com.evil", 68);
    assert_eq(_taar_dns_first_a(b, e), 0 - 1, "names sharing a prefix or suffix are other names");

    # The CNAME chain from the question is followed, in order, as glibc does.
    e = _t_msg(b, "example.com");
    e = _t_cname(b, e, q, "alias.test");
    e = _t_a(b, e, _t_last_cname, 5);
    assert_eq(_taar_dns_first_a(b, e), 0x0A000005, "CNAME, then A for its target");
    e = _t_msg(b, "example.com");
    e = _t_cname(b, e, q, "one.test");
    e = _t_cname(b, e, _t_last_cname, "two.test");
    e = _t_a(b, e, _t_last_cname, 6);
    assert_eq(_taar_dns_first_a(b, e), 0x0A000006, "two-hop CNAME chain");
    e = _t_msg(b, "example.com");
    e = _t_cname(b, e, q, "alias.test");
    e = _t_a(b, e, q, 7);
    assert_eq(_taar_dns_first_a(b, e), 0 - 1, "after a CNAME the question's own A is not the answer");
    e = _t_msg(b, "example.com");
    e = _t_a_lit(b, e, "evil.test", 66);
    var evil = e - 4 - 10 - 11;                   # "evil.test" encodes to 11 bytes
    e = _t_cname(b, e, evil, "x.test");
    e = _t_a(b, e, _t_last_cname, 66);
    assert_eq(_taar_dns_first_a(b, e), 0 - 1, "a chain that does not start at the question is ignored");
    # An A for the alias placed before the CNAME that introduces it: glibc reads
    # answers in order and does not take it either.
    e = _t_msg(b, "example.com");
    var a_at = e;
    e = _t_a_lit(b, e, "alias.test", 8);
    e = _t_ptr(b, e, q);
    e = _t_rr(b, e, _TAAR_DNS_TYPE_CNAME, 2);
    e = _t_ptr(b, e, a_at);
    assert_eq(_taar_dns_first_a(b, e), 0 - 1, "an out-of-order chain is not followed");

    # Hostile names.
    e = _t_msg(b, "example.com");
    var loop = e;
    store8(b + e, 1); store8(b + e + 1, 97);      # "a" then a pointer back to itself
    e = _t_ptr(b, e + 2, loop);
    e = _t_rr(b, e, _TAAR_DNS_TYPE_A, 4);
    e = e + 4;
    assert_eq(_taar_dns_first_a(b, e), 0 - 1, "an owner name that loops is refused, not followed forever");
    e = _t_msg(b, "example.com");
    e = _t_ptr(b, e, q);
    var rd = _t_rr(b, e, _TAAR_DNS_TYPE_CNAME, 2);
    e = _t_ptr(b, rd, rd);                        # the CNAME target points at itself
    e = _t_a(b, e, q, 9);
    assert_eq(_taar_dns_first_a(b, e), 0 - 1, "a CNAME whose target cannot be read refuses the reply");
    # A CNAME whose target name runs past its rdlength: rdata is the label "x"
    # (2 bytes), and the name only ends at the next record's first byte. Read
    # through, it is the name "x." — which the third record's owner matches.
    e = _t_msg(b, "example.com");
    e = _t_ptr(b, e, q);
    rd = _t_rr(b, e, _TAAR_DNS_TYPE_CNAME, 2);
    store8(b + rd, 1); store8(b + rd + 1, 120);   # label "x", no terminator
    e = rd + 2;
    store8(b + e, 0);                             # next record: owner "." ...
    e = _t_rr(b, e + 1, _TAAR_DNS_TYPE_A, 4) + 4; # ... an A for it
    e = _t_a_lit(b, e, "x", 9);
    assert_eq(_taar_dns_first_a(b, e), 0 - 1, "a CNAME target longer than its rdata refuses the reply");
    return 0;
}

# === dns: the name comparison itself ===
fn test_dns_name_eq() {
    test_group("dns-name-eq");
    var b = alloc(512);
    var e = _t_msg(b, "Example.COM");
    var lit = e;
    e = e + _taar_dns_encode_name("example.com", b + e);
    var ptr = e;
    e = _t_ptr(b, e, 12);
    var other = e;
    e = e + _taar_dns_encode_name("example.org", b + e);
    assert_eq(_taar_dns_name_eq(b, e, 12, 12), 1, "a name equals itself");
    assert_eq(_taar_dns_name_eq(b, e, 12, lit), 1, "equal ignoring case");
    assert_eq(_taar_dns_name_eq(b, e, ptr, lit), 1, "a pointer equals the name it points at");
    assert_eq(_taar_dns_name_eq(b, e, lit, other), 0, "a different last label");
    assert_eq(_taar_dns_name_eq(b, e, lit, lit + 8), 0, "a name and its own suffix differ");
    # Only ASCII letters fold: '[' (0x5B) is not '{' (0x7B).
    var x = alloc(64);
    var i = 0;
    while (i < 64) { store8(x + i, 0); i = i + 1; }
    store8(x + 12, 1); store8(x + 13, 0x5B);
    store8(x + 15, 1); store8(x + 16, 0x7B);
    assert_eq(_taar_dns_name_eq(x, 64, 12, 15), 0, "only A-Z fold to a-z");
    store8(x + 16, 0x5B);
    assert_eq(_taar_dns_name_eq(x, 64, 12, 15), 1, "the same byte matches");
    assert_eq(_taar_dns_name_eq(x, 15, 12, 15), 0, "a name past the end is malformed");
    # A label then a pointer back to it: both sides loop. The hop budget ends it.
    store8(x + 20, 1); store8(x + 21, 97);
    store8(x + 22, 0xC0); store8(x + 23, 20);
    assert_eq(_taar_dns_name_eq(x, 64, 20, 20), 0, "a looping name is malformed, not compared forever");
    assert_eq(_taar_dns_name_eq(x, 64, 20, 12), 0, "... against any other name too");
    # A forward pointer is refused even where its target is a good name: at 30,
    # a pointer to the name at 40 ("a."); compared with that name itself.
    store8(x + 30, 0xC0); store8(x + 31, 40);
    store8(x + 40, 1); store8(x + 41, 97); store8(x + 42, 0);
    assert_eq(_taar_dns_name_eq(x, 64, 40, 40), 1, "(the target name is good)");
    assert_eq(_taar_dns_name_eq(x, 64, 30, 40), 0, "a forward pointer is refused");
    # A pointer whose second byte lies past the message end is cut, even when
    # the byte that follows in memory would make it point back at a good name.
    # The pointer is the message's last word, back to "a." at 40.
    store8(x + 50, 0xC0); store8(x + 51, 40);
    assert_eq(_taar_dns_name_eq(x, 52, 50, 40), 1, "(a whole pointer to the name is fine)");
    assert_eq(_taar_dns_name_eq(x, 51, 50, 40), 0, "a pointer cut by the message end is malformed");
    # 0x40 / 0x80 are reserved label prefixes, not lengths. The buffer is big
    # enough that reading 0x40 as the length 64 would stay in bounds, so only
    # the prefix check can refuse it (as in test_dns_hostile).
    var big = alloc(256);
    i = 0;
    while (i < 256) { store8(big + i, 0); i = i + 1; }
    store8(big + 12, 0x40);
    assert_eq(_taar_dns_name_eq(big, 256, 12, 12), 0, "a reserved label prefix is malformed");
    return 0;
}

# === socket: a connect that hits its deadline says so (0.9.1) ===
# A loopback listener with a zero-length accept queue, filled by one
# connection of our own: Linux drops further SYNs, so the next connect waits
# out its SO_SNDTIMEO. connect(2) reports that as -EINPROGRESS; taar as
# TAAR_ERR_TIMEOUT, the value ADR 0001 lets a caller test.
fn test_tcp_connect_timeout() {
    test_group("tcp-connect-timeout");
    var lo = 0x7F000001;
    var l = sys_socket(2, 1, 6);
    var sa[16];
    _taar_fill_sockaddr(&sa, lo, 0);
    assert_eq(sys_bind(l, &sa, 16), 0, "listener bound to an ephemeral port");
    assert_eq(sys_listen(l, 0), 0, "zero-length accept queue");
    var len[8];
    store64(&len, 16);
    sys_getsockname(l, &sa, &len);
    var port = (load8(&sa + 2) << 8) | load8(&sa + 3);
    var filler = taar_tcp_open();
    assert_eq(taar_tcp_connect(filler, lo, port), 0, "one connection fills the queue");
    var fd = taar_tcp_open();
    taar_tcp_set_timeout_ms(fd, 300);
    assert_eq(taar_tcp_connect(fd, lo, port), TAAR_ERR_TIMEOUT, "a connect past its deadline is TAAR_ERR_TIMEOUT");
    taar_tcp_close(fd);
    taar_tcp_close(filler);
    sys_close(l);
    return 0;
}

# === the deprecated names (0.9.1) still answer as the new ones ===
# These calls make the build print "is deprecated" warnings on purpose: the
# aliases are shipped behaviour until 1.0.0, so they are tested until then.
fn test_deprecated_names() {
    test_group("deprecated-names");
    assert_eq(ipv4_parse("10.1.2.3"), taar_ipv4_parse("10.1.2.3"), "ipv4_parse is taar_ipv4_parse");
    var a = alloc(16);
    var b = alloc(16);
    assert_eq(ipv4_format_to_buf(0x0A010203, a), taar_ipv4_format_to_buf(0x0A010203, b),
      "ipv4_format_to_buf is taar_ipv4_format_to_buf");
    assert_eq(IPV4_PARSE_FAIL, TAAR_IPV4_PARSE_FAIL, "IPV4_PARSE_FAIL keeps its value");
    assert_eq(_TAAR_ERR_TIMEOUT, TAAR_ERR_TIMEOUT, "_TAAR_ERR_TIMEOUT keeps its value");
    assert_eq(_TAAR_ERR_INTR, TAAR_ERR_INTR, "_TAAR_ERR_INTR keeps its value");
    var sa = alloc(16);
    var sb = alloc(16);
    taar_fill_sockaddr(sa, 0x0A010203, 53);
    _taar_fill_sockaddr(sb, 0x0A010203, 53);
    assert_eq(memeq(sa, sb, 16), 1, "taar_fill_sockaddr is the internal fill");
    var fd = taar_tcp_open();
    assert_eq(taar_sock_close(fd), 0, "taar_sock_close closes like taar_tcp_close");
    return 0;
}

# === dns: the TCP read loop is bounded in passes, not just bytes ===
#
# SOCK_SEQPACKET keeps message boundaries, so each read returns one record —
# a deterministic stand-in for a peer that drips its reply a byte at a time.
# Without a pass cap a 2 KB reply could take 2,048 reads, each allowed the full
# receive timeout.
fn test_dns_tcp_read_cap() {
    test_group("dns-tcp-read-cap");
    var fds[16];
    store64(&fds, 0);
    assert_eq(sys_socketpair(1, 5, 0, &fds), 0, "seqpacket socketpair available");   # AF_UNIX, SOCK_SEQPACKET
    var a = load32(&fds);
    var c = load32(&fds + 4);
    taar_tcp_set_timeout_ms(a, 200);
    var one[8];
    store8(&one, 65);
    var i = 0;
    while (i < 40) { sys_write(c, &one, 1); i = i + 1; }
    var buf[64];
    var got = _taar_dns_tcp_read_all(a, &buf, 40);
    assert_eq(got, _TAAR_DNS_TCP_MAX_READS, "byte-at-a-time peer stops at the pass cap");
    # A reply that arrives in one piece is unaffected.
    var drain = 0;
    while (drain < 40) { if (sys_read(a, &buf, 64) <= 0) { break; } drain = drain + 1; }
    var whole[64];
    i = 0;
    while (i < 40) { store8(&whole + i, 66); i = i + 1; }
    sys_write(c, &whole, 40);
    assert_eq(_taar_dns_tcp_read_all(a, &buf, 40), 40, "whole reply read in one pass");
    sys_close(a);
    sys_close(c);
    return 0;
}

# === socket: taar_tcp_set_timeout_ms also bounds blocking sends (and connect) ===
#
# On Linux SO_RCVTIMEO bounds only reads; connect(2) and write(2) honour
# SO_SNDTIMEO. Without it, a TCP retry to a resolver whose TCP/53 is filtered
# sat in connect for the kernel's ~127 s of SYN retries
# (tests/integration/tc_fallback.sh, tc_blackhole). The connect half needs a
# network to prove; the send half is provable here: fill a socketpair until a
# write must block, and check it comes back at the deadline. Unfixed, this
# write blocks forever and the runner's per-test timeout reports it.
fn test_socket_send_timeout() {
    test_group("socket-send-timeout");
    var fds[16];
    store64(&fds, 0);
    assert_eq(sys_socketpair(1, 1, 0, &fds), 0, "socketpair available");
    var a = load32(&fds);
    var c = load32(&fds + 4);
    assert_eq(taar_tcp_set_timeout_ms(a, 200), 0, "timeout set");
    var chunk = alloc(65536);
    var n = 1;
    var i = 0;
    while (i < 1024) {
        n = taar_tcp_send(a, chunk, 65536);
        if (n < 0) { break; }
        i = i + 1;
    }
    assert_eq(n, TAAR_ERR_TIMEOUT, "a send into a full buffer returns at the deadline");
    sys_close(a);
    sys_close(c);
    # A send to a peer that has gone is an error, not a signal. Under write(2)
    # SIGPIPE would end this whole test process here, before the assert.
    store64(&fds, 0);
    sys_socketpair(1, 1, 0, &fds);
    a = load32(&fds);
    assert_eq(taar_tcp_send(a, "x", 0), 0, "an empty send on a live connection is 0");
    sys_close(load32(&fds + 4));
    assert_eq(taar_tcp_send(a, "x", 1), 0 - 32, "a send to a closed peer is -EPIPE, not SIGPIPE");
    sys_close(a);
    return 0;
}

# === socket: AGNOS poll-loop deadline arithmetic (pure, so testable here) ===
#
# AGNOS has no SO_RCVTIMEO, so its recv paths poll against these. 0 must mean
# "no deadline", as it does for SO_RCVTIMEO on Linux; it used to mean "already
# expired", so a caller asking to block indefinitely got an instant timeout.
fn test_poll_deadline() {
    test_group("poll-deadline");
    assert_eq(_taar_poll_deadline(1000, 50), 1050, "deadline = now + timeout");
    assert_eq(_taar_poll_deadline(1000, 0), 0 - 1, "0 = no deadline");
    assert_eq(_taar_poll_expired(1049, 1050), 0, "before the deadline");
    assert_eq(_taar_poll_expired(1050, 1050), 1, "at the deadline");
    assert_eq(_taar_poll_expired(999999999, 0 - 1), 0, "no deadline never expires");
    return 0;
}

# === socket: AGNOS reply-source filter (pure; the kernel's addr_out layout) ===
#
# AGNOS UDP listeners are unconnected: the kernel hands over any datagram for
# the port. taar_udp_recv drops one whose recorded source (ip @+0, port @+8,
# as udp_recv#53 writes them) is not the peer taar_udp_send recorded.
fn test_peer_match() {
    test_group("peer-match");
    var from[16];
    store64(&from, 0x0A000035);                  # 10.0.0.53
    store64(&from + 8, 53);
    assert_eq(_taar_peer_match(&from, 0x0A000035, 53), 1, "reply from the peer accepted");
    assert_eq(_taar_peer_match(&from, 0x0A000036, 53), 0, "other address dropped");
    assert_eq(_taar_peer_match(&from, 0x0A000035, 5353), 0, "other port dropped");
    assert_eq(_taar_peer_match(&from, 0, 0), 1, "no peer recorded: any sender, as unconnected");
    return 0;
}

# Suite entry: runs every group in order; exit code is the failure count.
fn main() {
    alloc_init();
    test_ipv4_parse();
    test_ipv4_format();
    test_sockaddr();
    test_dns_encode();
    test_dns_build();
    test_dns_parse_a();
    test_dns_reply_match();
    test_dns_hostile();
    test_dns_encode_edges();
    test_resolve_guards();
    test_dns_tcp_frame();
    test_dns_reply_ok();
    test_socket_recv_contract();
    test_resolv_parse();
    test_resolv_choose();
    test_resolv_conf();
    test_dns_encode_bounds();
    test_dns_answer_class();
    test_dns_owner();
    test_dns_name_eq();
    test_tcp_connect_timeout();
    test_deprecated_names();
    test_dns_tcp_read_cap();
    test_socket_send_timeout();
    test_poll_deadline();
    test_peer_match();
    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
