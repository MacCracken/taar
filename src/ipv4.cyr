# ipv4.cyr — strict dotted-quad IPv4 address codec (taar substrate).
#
# taar's canonical home for IPv4 parse/format. Supersedes the
# byte-identical in-tree copies that yo (src/ipv4.cyr) and dig
# (src/ipv4.cyr) carried before the extraction — both fold onto this
# module via [deps.taar]. The duplication between those two tools was
# the documented extraction trigger.
#
# Single-purpose. Pure code (no syscalls). Mirrors
# agnos/kernel/core/net.cyr ip4() packing:
#   (a<<24) | (b<<16) | (c<<8) | d
# so a parsed address is byte-comparable with kernel-side struct fields
# and ready directly as the packed-addr argument to the agnos
# sock_connect / udp_send syscalls. Hostname/DNS resolution is a
# separate concern (taar/src/dns.cyr, folds in when a consumer needs it).
#
# Strict grammar: D '.' D '.' D '.' D '\0'  where D = one to three
# decimal digits, value in [0, 255], with no leading zero ("0" is an
# octet, "00" and "010" are not). No empty segments. No leading
# garbage. No trailing garbage. No spaces.
#
# Leading zeros are refused because they are ambiguous: inet_aton(3)
# reads "010" as octal 8, while a decimal reader says 10, so the same
# string named two different hosts depending on which parser saw it.
# glibc's inet_pton, Go (1.17) and Python (3.9.5, CVE-2021-29921) all
# refuse them; through 0.8.1 taar read them as decimal.

var TAAR_IPV4_PARSE_FAIL = 0 - 1;   # i64 sentinel; any valid packed v4 is ≤ 0xFFFFFFFF.
# DEPRECATED (0.9.1, removed at 1.0.0 — ADR 0002): the pre-0.9.1 name. Not
# marked #deprecated: cyrius has no such mark for a var, and one written here
# would attach to the next fn (cyrius issue 2026-11-09).
var IPV4_PARSE_FAIL = 0 - 1;

# Parse a dotted-quad into a packed u32. Returns the packed address on
# success, TAAR_IPV4_PARSE_FAIL on any rejection. Caller checks `result < 0`
# to detect failure.
fn taar_ipv4_parse(s): i64 {
    if (s == 0) { return TAAR_IPV4_PARSE_FAIL; }
    var i = 0;
    var packed = 0;
    var seg = 0;
    while (seg < 4) {
        var oct = 0;
        var digits = 0;
        var c = load8(s + i);
        var lead = c;                                  # the octet's first digit
        while (c >= 48) {
            if (c > 57) { break; }
            oct = oct * 10 + (c - 48);
            if (oct > 255) { return TAAR_IPV4_PARSE_FAIL; }
            digits = digits + 1;
            if (digits > 3) { return TAAR_IPV4_PARSE_FAIL; }
            i = i + 1;
            c = load8(s + i);
        }
        if (digits == 0) { return TAAR_IPV4_PARSE_FAIL; }
        if (digits > 1) {
            if (lead == 48) { return TAAR_IPV4_PARSE_FAIL; }    # a leading '0'
        }
        packed = (packed << 8) | oct;
        if (seg < 3) {
            if (c != 46) { return TAAR_IPV4_PARSE_FAIL; }   # '.' = 46
            i = i + 1;
        } else {
            if (c != 0) { return TAAR_IPV4_PARSE_FAIL; }    # must terminate after 4th octet
        }
        seg = seg + 1;
    }
    return packed;
}

# Format a packed v4 as dotted-quad into buf. Buf must hold at least
# 16 bytes (worst case "255.255.255.255\0" = 16). Returns bytes
# written (without a trailing NUL).
fn taar_ipv4_format_to_buf(packed_addr, buf): i64 {
    var pos = 0;
    pos = pos + fmt_int_buf((packed_addr >> 24) & 0xFF, buf + pos);
    store8(buf + pos, 46); pos = pos + 1;
    pos = pos + fmt_int_buf((packed_addr >> 16) & 0xFF, buf + pos);
    store8(buf + pos, 46); pos = pos + 1;
    pos = pos + fmt_int_buf((packed_addr >> 8)  & 0xFF, buf + pos);
    store8(buf + pos, 46); pos = pos + 1;
    pos = pos + fmt_int_buf(packed_addr & 0xFF, buf + pos);
    return pos;
}

# --- deprecated names (0.9.1; removed at 1.0.0 — ADR 0002) ---
# The codec kept the names yo and dig shipped before the extraction; 0.9.1
# brings it under the taar_ prefix every other public name carries.

# DEPRECATED (0.9.1): use taar_ipv4_parse.
#deprecated("use taar_ipv4_parse; ipv4_parse is removed at taar 1.0.0")
fn ipv4_parse(s): i64 { return taar_ipv4_parse(s); }

# DEPRECATED (0.9.1): use taar_ipv4_format_to_buf.
#deprecated("use taar_ipv4_format_to_buf; ipv4_format_to_buf is removed at taar 1.0.0")
fn ipv4_format_to_buf(packed_addr, buf): i64 { return taar_ipv4_format_to_buf(packed_addr, buf); }
