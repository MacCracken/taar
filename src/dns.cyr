# taar — DNS resolver: hostname → IPv4 (A record), over UDP-53, retried over
# TCP-53 when the UDP reply is truncated (TC).
#
# Ported from dig's dns.cyr (RFC 1035 framing) + resolv.cyr (resolver discovery),
# narrowed to the A-record resolve path the net-tools family needs. Builds on
# taar's ipv4 + socket modules. Public surface = `taar_resolve_ipv4(host)`.
#
# All framing helpers are `_taar_dns_*` / `_taar_resolv_*`-prefixed so this
# coexists with dig's own src/dns.cyr until dig is refactored onto taar.
#
# Requires earlier in the bundle: src/ipv4.cyr, src/socket.cyr.

var _TAAR_DNS_TYPE_A        = 1;
var _TAAR_DNS_TYPE_CNAME    = 5;
var _TAAR_DNS_CLASS_IN      = 1;
var _TAAR_DNS_FLAG_RD       = 0x0100;
var _TAAR_DNS_HEADER_LEN    = 12;
var _TAAR_DNS_MAX_LABEL     = 63;
var _TAAR_DNS_MAX_NAME      = 255;
var _TAAR_DNS_MAX_HOPS      = 32;
var _TAAR_DNS_RCODE_NOERROR = 0;
var _TAAR_DNS_RCODE_NXDOMAIN = 3;
# What _taar_dns_ask returns when this server gave no verdict, so the next one
# should be asked. Distinct from -1 (a final "no address") and from any
# address (>= 0).
var _TAAR_DNS_TRY_NEXT      = 0 - 2;
# Datagrams to examine before giving up on a matching reply. Stray, duplicate
# and forged packets are discarded and the wait continues rather than aborting
# the whole resolve — one unmatched packet used to be enough to kill it.
var _TAAR_DNS_MAX_REPLIES   = 8;
# Scratch sizes. Query: 12 header + 255 max wire name + 4 qtype/qclass = 271.
# Reply: 2048 covers the 512-byte classic UDP limit with EDNS headroom.
# Array declarations need literal sizes, so `var qbuf[300]` / `var rbuf[2048]`
# below spell these out; every other use goes through the names.
var _TAAR_DNS_QBUF_LEN      = 300;
var _TAAR_DNS_RBUF_LEN      = 2048;
# A send that accepts 0 bytes is "no progress yet", not an error. One retry,
# then give up. Defence in depth since 0.7.0, and untested for that reason: with
# a deadline set (this path always sets one) neither backend returns 0 for a
# non-empty send — Linux reports SO_SNDTIMEO as -EAGAIN, and AGNOS taar_tcp_send
# now maps the kernel's 0 to _TAAR_ERR_TIMEOUT. Through 0.6.2 AGNOS did return
# 0 (sock_send#48, after ~8 s without progress), and a cap of 64 let a stalled
# peer hold the retry for ~8.5 min.
var _TAAR_DNS_TCP_MAX_SPINS  = 1;
# Reads allowed for one framed message. Each read may wait the full receive
# timeout, so without a cap a peer dripping one byte at a time could hold a
# 2 KB reply open for 2,048 timeouts (hours). A real reply needs a handful of
# reads; 16 is generous. A true total deadline needs a monotonic clock the
# consumers' stdlib does not carry (see roadmap).
var _TAAR_DNS_TCP_MAX_READS  = 16;
var _TAAR_DNS_TCP_OUT_LEN    = 304;      # framed query: QBUF_LEN + 2-byte prefix + slack

var _TAAR_RESOLV_FALLBACK = 0x08080808;   # 8.8.8.8

# Resolver configuration, with glibc's defaults and caps (musl's agree).
var _TAAR_RESOLV_MAXNS         = 3;    # nameservers used, in file order (glibc MAXNS)
var _TAAR_RESOLV_TIMEOUT_S     = 5;    # per query, `options timeout:` (RES_TIMEOUT)
var _TAAR_RESOLV_MAX_TIMEOUT_S = 30;   # its cap (RES_MAXRETRANS)
var _TAAR_RESOLV_ATTEMPTS      = 2;    # rounds over the servers, `options attempts:` (RES_DFLRETRY)
var _TAAR_RESOLV_MAX_ATTEMPTS  = 5;    # its cap (RES_MAXRETRY)
# The parsed configuration lives in a 48-byte block the caller provides
# (`var cfg[48]`): nameservers at +0 / +8 / +16, then these fields.
var _TAAR_RESOLV_CFG_COUNT    = 24;    # usable nameservers, 0..3
var _TAAR_RESOLV_CFG_TIMEOUT  = 32;    # per-query timeout, ms
var _TAAR_RESOLV_CFG_ATTEMPTS = 40;    # rounds

# Entropy + file reads come from socket.cyr's platform helpers
# (_taar_plat_random_u16 / _taar_plat_read_file) so this module stays
# platform-neutral RFC-1035 framing across the Linux / AGNOS backends.

# --- wire framing (RFC 1035) ---

fn _taar_dns_store_u16(buf, off, val): i64 {
    store8(buf + off, (val >> 8) & 0xFF);
    store8(buf + off + 1, val & 0xFF);
    return 0;
}
fn _taar_dns_load_u16(buf, off): i64 {
    return (load8(buf + off) << 8) | load8(buf + off + 1);
}
fn _taar_dns_hdr_id(msg): i64      { return (load8(msg) << 8) | load8(msg + 1); }
fn _taar_dns_hdr_qdcount(msg): i64 { return (load8(msg + 4) << 8) | load8(msg + 5); }
fn _taar_dns_hdr_ancount(msg): i64 { return (load8(msg + 6) << 8) | load8(msg + 7); }
fn _taar_dns_hdr_rcode(msg): i64   { return ((load8(msg + 2) << 8) | load8(msg + 3)) & 0x0F; }
# QR (bit 15 of the flags word): 1 = response, 0 = query. An unsolicited query
# arriving at our source port must never be parsed as though it were an answer.
fn _taar_dns_hdr_qr(msg): i64      { return (load8(msg + 2) >> 7) & 1; }
# TC (bit 9): the server truncated the message. Not rejected here — any A
# record that did fit is still authoritative-as-sent — and taar_resolve_ipv4
# retries over TCP-53 for the complete answer (since 0.4.0).
fn _taar_dns_hdr_tc(msg): i64      { return (load8(msg + 2) >> 1) & 1; }
# OPCODE, flags bits 14..11: 0 = QUERY, the only kind taar sends.
fn _taar_dns_hdr_opcode(msg): i64  { return (load8(msg + 2) >> 3) & 0x0F; }

# Encode "example.com" → wire labels at `out`. Returns bytes written, or 0.
fn _taar_dns_encode_name(name, out): i64 {
    var src = 0;
    var dst = 0;
    var label_start = dst;
    store8(out + dst, 0);
    dst = dst + 1;
    while (1) {
        var c = load8(name + src);
        if (c == 0) {
            if (dst - label_start == 1) {
                # src == 0 → the whole name was empty; anything else is a
                # legitimate trailing dot ("example.com."), already terminated.
                if (src == 0) { return 0; }
                return dst;
            }
            var llen = dst - label_start - 1;
            if (llen > _TAAR_DNS_MAX_LABEL) { return 0; }
            store8(out + label_start, llen);
            store8(out + dst, 0);
            dst = dst + 1;
            if (dst > _TAAR_DNS_MAX_NAME) { return 0; }
            return dst;
        }
        if (c == 46) {
            var llen2 = dst - label_start - 1;
            if (llen2 == 0) { return 0; }
            if (llen2 > _TAAR_DNS_MAX_LABEL) { return 0; }
            store8(out + label_start, llen2);
            label_start = dst;
            store8(out + dst, 0);
            dst = dst + 1;
        } else {
            store8(out + dst, c);
            dst = dst + 1;
        }
        if (dst > _TAAR_DNS_MAX_NAME) { return 0; }
        src = src + 1;
    }
    return 0;
}

# Build an A/IN query for `name` into `buf`. Returns total length or 0.
fn _taar_dns_build_query(buf, id, name): i64 {
    _taar_dns_store_u16(buf, 0, id);
    _taar_dns_store_u16(buf, 2, _TAAR_DNS_FLAG_RD);
    _taar_dns_store_u16(buf, 4, 1);    # QDCOUNT
    _taar_dns_store_u16(buf, 6, 0);
    _taar_dns_store_u16(buf, 8, 0);
    _taar_dns_store_u16(buf, 10, 0);
    var n = _taar_dns_encode_name(name, buf + _TAAR_DNS_HEADER_LEN);
    if (n == 0) { return 0; }
    _taar_dns_store_u16(buf, _TAAR_DNS_HEADER_LEN + n, _TAAR_DNS_TYPE_A);
    _taar_dns_store_u16(buf, _TAAR_DNS_HEADER_LEN + n + 2, _TAAR_DNS_CLASS_IN);
    return _TAAR_DNS_HEADER_LEN + n + 4;
}

# Skip a wire name; return the offset past it. Backward-pointer + hop-budget
# guarded (rejects crafted pointer loops). 0 on parse error.
fn _taar_dns_skip_name(msg, msg_len, off): i64 {
    var cur = off;
    var end_off = 0;
    var hops = 0;
    while (1) {
        if (cur >= msg_len) { return 0; }
        var b = load8(msg + cur);
        if (b == 0) {
            cur = cur + 1;
            if (end_off == 0) { end_off = cur; }
            return end_off;
        }
        if ((b & 0xC0) == 0xC0) {
            if (cur + 1 >= msg_len) { return 0; }
            var b2 = load8(msg + cur + 1);
            var ptr = ((b & 0x3F) << 8) | b2;
            # Redundant given the `ptr >= cur` rule below (cur < msg_len is
            # already established at the top of the loop) — kept as a bound
            # that survives if that ordering is ever refactored.
            if (ptr >= msg_len) { return 0; }
            if (end_off == 0) { end_off = cur + 2; }
            # Load-bearing, not belt-and-braces: a pointer may only go backward,
            # but a label can then walk forward past it again, so
            # [label][ptr -> that label] loops forever on the backward rule
            # alone. Pinned by test_dns_hostile's "label + back-pointer loop".
            hops = hops + 1;
            if (hops > _TAAR_DNS_MAX_HOPS) { return 0; }
            if (ptr >= cur) { return 0; }
            cur = ptr;
        } else {
            if (b > _TAAR_DNS_MAX_LABEL) { return 0; }
            cur = cur + 1 + b;
        }
    }
    return 0;
}

# Follow compression pointers from `off` to the next label byte, under
# _taar_dns_skip_name's rules: a pointer must point backward and in bounds, and
# `hops` (a counter the caller keeps per name, at `hops_ptr`) may not exceed
# _TAAR_DNS_MAX_HOPS. Returns that label's offset, or -1 if the name is malformed.
fn _taar_dns_label_at(msg, msg_len, off, hops_ptr): i64 {
    while (1) {
        if (off >= msg_len) { return 0 - 1; }
        var b = load8(msg + off);
        if ((b & 0xC0) != 0xC0) { return off; }
        if (off + 1 >= msg_len) { return 0 - 1; }
        var ptr = ((b & 0x3F) << 8) | load8(msg + off + 1);
        var hops = load64(hops_ptr) + 1;
        store64(hops_ptr, hops);
        if (hops > _TAAR_DNS_MAX_HOPS) { return 0 - 1; }
        if (ptr >= off) { return 0 - 1; }
        off = ptr;
    }
    return 0 - 1;
}

# Do the wire names at offsets `a` and `b` of `msg` spell the same name?
# Letters compare without case (RFC 4343: "Example.COM" is "example.com"),
# and only A-Z fold. Both sides follow compression pointers under the same
# backward-only rule and hop budget as _taar_dns_skip_name, so a hostile message
# cannot loop it. 1 = the same name; 0 = different, or either is malformed.
fn _taar_dns_name_eq(msg, msg_len, a, b): i64 {
    var ha = 0;
    var hb = 0;
    while (1) {
        a = _taar_dns_label_at(msg, msg_len, a, &ha);
        if (a < 0) { return 0; }
        b = _taar_dns_label_at(msg, msg_len, b, &hb);
        if (b < 0) { return 0; }
        var la = load8(msg + a);
        if (la != load8(msg + b)) { return 0; }
        if (la == 0) { return 1; }
        if (la > _TAAR_DNS_MAX_LABEL) { return 0; }
        # Not observable in the result — a label that overruns msg_len always
        # fails at its next label_at — but these keep every read below inside
        # msg_len rather than up to 63 bytes past it.
        if (a + 1 + la > msg_len) { return 0; }
        if (b + 1 + la > msg_len) { return 0; }
        var i = 1;
        while (i <= la) {
            var ca = load8(msg + a + i);
            var cb = load8(msg + b + i);
            if (ca >= 65) { if (ca <= 90) { ca = ca + 32; } }
            if (cb >= 65) { if (cb <= 90) { cb = cb + 32; } }
            if (ca != cb) { return 0; }
            i = i + 1;
        }
        a = a + 1 + la;
        b = b + 1 + la;
    }
    return 0;
}

# Offset of the answer section (past the question(s)), or 0.
fn _taar_dns_answer_start(msg, msg_len): i64 {
    if (msg_len < _TAAR_DNS_HEADER_LEN) { return 0; }
    var qd = _taar_dns_hdr_qdcount(msg);
    var off = _TAAR_DNS_HEADER_LEN;
    var i = 0;
    while (i < qd) {
        var p = _taar_dns_skip_name(msg, msg_len, off);
        if (p == 0) { return 0; }
        if (p + 4 > msg_len) { return 0; }
        off = p + 4;
        i = i + 1;
    }
    return off;
}

# The address the answer section gives for the question, or -1: the first
# class-IN A record (rdlength 4) whose owner is the name asked, or the end of
# the CNAME chain from it. Answers are read in order, as glibc reads them: a
# class-IN CNAME whose owner is the current name moves the name to its target,
# so an A for an alias counts only after the CNAME that introduces it, and the
# question's own A no longer counts once it has been aliased (RFC 1034 §3.6.2:
# a name with a CNAME has no other data).
#
# Owners compare without case (_taar_dns_name_eq). The question sits at offset
# 12 and is the one we asked: _taar_dns_reply_ok has already checked the echo.
# A CNAME whose target cannot be read, or runs past its rdlength, refuses the
# whole reply: a broken answer section is not trusted for any of its records.
#
# Until 0.8.1 the owner was not checked at all, and the first class-IN A record
# was taken whatever name it was for — so a resolver answering with records for
# other names (broken, or hostile, or a cache polluted by one) decided where
# taar connected. glibc checks the owner; musl does not.
fn _taar_dns_first_a(msg, msg_len): i64 {
    var off = _taar_dns_answer_start(msg, msg_len);
    if (off == 0) { return 0 - 1; }
    var name = _TAAR_DNS_HEADER_LEN;                 # the question's name
    var an = _taar_dns_hdr_ancount(msg);
    var i = 0;
    while (i < an) {
        var p = _taar_dns_skip_name(msg, msg_len, off);
        if (p == 0) { return 0 - 1; }
        if (p + 10 > msg_len) { return 0 - 1; }
        var rtype = _taar_dns_load_u16(msg, p);
        var rclass = _taar_dns_load_u16(msg, p + 2);
        var rdlen = _taar_dns_load_u16(msg, p + 8);
        var rdata = p + 10;
        if (rdata + rdlen > msg_len) { return 0 - 1; }
        if (rclass == _TAAR_DNS_CLASS_IN) {
            if (_taar_dns_name_eq(msg, msg_len, off, name) == 1) {
                if (rtype == _TAAR_DNS_TYPE_A) {
                    if (rdlen == 4) {
                        var o0 = load8(msg + rdata);
                        var o1 = load8(msg + rdata + 1);
                        var o2 = load8(msg + rdata + 2);
                        var o3 = load8(msg + rdata + 3);
                        return (o0 << 24) | (o1 << 16) | (o2 << 8) | o3;
                    }
                }
                if (rtype == _TAAR_DNS_TYPE_CNAME) {
                    var t = _taar_dns_skip_name(msg, msg_len, rdata);
                    # Redundant in effect: an unreadable target would never
                    # match an owner anyway (_taar_dns_name_eq refuses a
                    # malformed name), so removing this leaves the result -1.
                    # Kept so a broken reply is refused here, not by accident.
                    if (t == 0) { return 0 - 1; }
                    if (t > rdata + rdlen) { return 0 - 1; }
                    name = rdata;
                }
            }
        }
        off = rdata + rdlen;
        i = i + 1;
    }
    return 0 - 1;
}

# Does the reply echo back the exact question we asked?
#
# RFC 1035 requires a server to copy the question section verbatim, so a
# byte-compare of [12, qlen) against the query we sent binds the reply to this
# specific QNAME/QTYPE/QCLASS. Without it, a reply carrying the right ID could
# answer a different question entirely and taar would take its first A record.
fn _taar_dns_same_question(qbuf, qlen, rbuf, rlen): i64 {
    if (qlen <= _TAAR_DNS_HEADER_LEN) { return 0; }
    if (rlen < qlen) { return 0; }
    var i = _TAAR_DNS_HEADER_LEN;
    while (i < qlen) {
        if (load8(rbuf + i) != load8(qbuf + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# --- resolv.conf discovery (ported from dig's resolv.cyr) ---

fn _taar_resolv_skip_blank(buf, len, i): i64 {
    while (i < len) {
        var c = load8(buf + i);
        if (c == 32) { i = i + 1; }
        elif (c == 9) { i = i + 1; }
        else { return i; }
    }
    return i;
}
fn _taar_resolv_find_eol(buf, len, i): i64 {
    while (i < len) {
        if (load8(buf + i) == 10) { return i; }
        i = i + 1;
    }
    return len;
}
fn _taar_resolv_match(buf, len, i, lit, lit_len): i64 {
    if (i + lit_len > len) { return 0; }
    var k = 0;
    while (k < lit_len) {
        if (load8(buf + i + k) != load8(lit + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# `lit` at `i`, as a whole word: followed by a space or tab before `lim`.
fn _taar_resolv_keyword(buf, lim, i, lit, lit_len): i64 {
    if (_taar_resolv_match(buf, lim, i, lit, lit_len) == 0) { return 0; }
    if (i + lit_len >= lim) { return 0; }
    var c = load8(buf + i + lit_len);
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    return 0;
}

# End of the token starting at `j`: the next space, tab or CR, or `lim`. The CR
# is what lets CRLF files parse.
fn _taar_resolv_token_end(buf, lim, j): i64 {
    while (j < lim) {
        var c = load8(buf + j);
        if (c == 32) { return j; }
        if (c == 9) { return j; }
        if (c == 13) { return j; }
        j = j + 1;
    }
    return lim;
}

# The token `buf[s, e)` as a packed IPv4 address (strict dotted quad), or -1.
# A token over 64 bytes is refused before it is copied: the copy goes into
# tmp[80], and no dotted quad is longer than 15.
fn _taar_resolv_addr(buf, s, e): i64 {
    var n = e - s;
    if (n <= 0) { return 0 - 1; }
    if (n > 64) { return 0 - 1; }
    var tmp[80];
    var k = 0;
    while (k < n) { store8(&tmp + k, load8(buf + s + k)); k = k + 1; }
    store8(&tmp + n, 0);
    return ipv4_parse(&tmp);
}

# `buf[s, e)` as a decimal number, or -1 unless it is 1 to 6 digits.
fn _taar_resolv_num(buf, s, e): i64 {
    if (e <= s) { return 0 - 1; }
    if (e - s > 6) { return 0 - 1; }
    var v = 0;
    var i = s;
    while (i < e) {
        var c = load8(buf + i);
        if (c < 48) { return 0 - 1; }
        if (c > 57) { return 0 - 1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

# Apply one `options` line, from `i` to `eol`: `timeout:N` (seconds) and
# `attempts:N`, each clamped as glibc clamps it, with 0 raised to 1 (glibc
# would make no attempt at all). Every other option is ignored: taar has no
# search list, rotation or EDNS to configure. A later line overrides an earlier.
fn _taar_resolv_options(buf, eol, i, cfg): i64 {
    while (i < eol) {
        i = _taar_resolv_skip_blank(buf, eol, i);
        var end = _taar_resolv_token_end(buf, eol, i);
        if (end == i) { return 0; }
        if (_taar_resolv_match(buf, end, i, "timeout:", 8) == 1) {
            var t = _taar_resolv_num(buf, i + 8, end);
            if (t >= 0) {
                if (t < 1) { t = 1; }
                if (t > _TAAR_RESOLV_MAX_TIMEOUT_S) { t = _TAAR_RESOLV_MAX_TIMEOUT_S; }
                store64(cfg + _TAAR_RESOLV_CFG_TIMEOUT, t * 1000);
            }
        } elif (_taar_resolv_match(buf, end, i, "attempts:", 9) == 1) {
            var a = _taar_resolv_num(buf, i + 9, end);
            if (a >= 0) {
                if (a < 1) { a = 1; }
                if (a > _TAAR_RESOLV_MAX_ATTEMPTS) { a = _TAAR_RESOLV_MAX_ATTEMPTS; }
                store64(cfg + _TAAR_RESOLV_CFG_ATTEMPTS, a);
            }
        }
        i = end;
    }
    return 0;
}

# Parse resolv.conf text into `cfg` (see _TAAR_RESOLV_CFG_*): up to
# _TAAR_RESOLV_MAXNS usable `nameserver` addresses in file order, and the
# `options` timeout and attempts, defaulting to glibc's 5 s and 2. Returns the
# number of usable nameservers; 0 if the text names no nameserver at all; or -1
# if it names nameservers but none taar can use — IPv6 addresses, 0.0.0.0,
# anything malformed. The caller must keep those last two apart: "no resolver
# configured" and "a resolver configured that taar cannot reach" call for
# different answers (see _taar_resolv_choose).
#
# Usable means a strict IPv4 dotted quad. glibc takes its three from every
# entry, IPv6 included; taar takes the first three it can use, so a file
# listing three IPv6 servers and then an IPv4 one still reaches the IPv4 one.
fn _taar_resolv_parse(buf, len, cfg): i64 {
    store64(cfg + _TAAR_RESOLV_CFG_COUNT, 0);
    store64(cfg + _TAAR_RESOLV_CFG_TIMEOUT, _TAAR_RESOLV_TIMEOUT_S * 1000);
    store64(cfg + _TAAR_RESOLV_CFG_ATTEMPTS, _TAAR_RESOLV_ATTEMPTS);
    if (buf == 0) { return 0; }
    if (len <= 0) { return 0; }
    var saw = 0;                       # a nameserver entry was present
    var count = 0;
    var i = 0;
    while (i < len) {
        i = _taar_resolv_skip_blank(buf, len, i);
        if (i >= len) { break; }
        var eol = _taar_resolv_find_eol(buf, len, i);
        if (_taar_resolv_keyword(buf, eol, i, "nameserver", 10) == 1) {
            var j = _taar_resolv_skip_blank(buf, eol, i + 10);
            var end = _taar_resolv_token_end(buf, eol, j);
            if (end > j) {
                saw = 1;
                var addr = _taar_resolv_addr(buf, j, end);
                if (addr > 0) {
                    if (count < _TAAR_RESOLV_MAXNS) {
                        store64(cfg + count * 8, addr);
                        count = count + 1;
                    }
                }
            }
        } elif (_taar_resolv_keyword(buf, eol, i, "options", 7) == 1) {
            _taar_resolv_options(buf, eol, i + 7, cfg);
        }
        i = eol + 1;
    }
    store64(cfg + _TAAR_RESOLV_CFG_COUNT, count);
    if (count > 0) { return count; }
    if (saw == 1) { return 0 - 1; }
    return 0;
}

# Length of `buf[0, n)` up to and including its last newline, or 0 if it has
# none. Applied when a read filled the whole buffer: the file may be longer,
# so its last line may have been cut — "nameserver 10.0.0.12" read as
# "nameserver 10.0.0.1" is a well-formed, wrong address.
fn _taar_resolv_complete_len(buf, n): i64 {
    var i = n;
    while (i > 0) {
        if (load8(buf + i - 1) == 10) { return i; }
        i = i - 1;
    }
    return 0;
}

# Make `cfg` the single nameserver `ns` with the default timeout and attempts.
fn _taar_resolv_only(cfg, ns): i64 {
    _taar_resolv_parse(0, 0, cfg);
    store64(cfg, ns);
    store64(cfg + _TAAR_RESOLV_CFG_COUNT, 1);
    return 1;
}

# The discovery decision, pure so the suite can drive it. `ksrv` is the
# kernel-leased resolver (0 if none), `buf`/`n` the resolv.conf read (n < 0 if
# the read failed), `cap` the buffer size it was read into. Fills `cfg` and
# returns how many nameservers it holds, or 0 to fail the resolve.
#
#   kernel lease                          -> that one, default options
#   usable nameservers in the file        -> up to three, with the file's options
#   no file                               -> _TAAR_RESOLV_FALLBACK (8.8.8.8)
#   a file naming no nameserver           -> 8.8.8.8, with the file's options
#   nameservers present, none usable      -> 0: fail closed
#   file larger than the buffer, no usable
#   nameserver in its complete lines      -> 0: fail closed
#
# Fail closed, because the host has chosen a resolver (a VPN's, a
# split-horizon or filtering one) and sending its lookups to a public resolver
# instead would bypass that choice and disclose every hostname to a third
# party. Until 0.6.2 both of those cases fell through to 8.8.8.8.
fn _taar_resolv_choose(ksrv, buf, n, cap, cfg): i64 {
    if (ksrv > 0) { return _taar_resolv_only(cfg, ksrv); }
    if (n <= 0) { return _taar_resolv_only(cfg, _TAAR_RESOLV_FALLBACK); }
    var len = n;
    var cut = 0;
    if (n >= cap) {
        cut = 1;
        len = _taar_resolv_complete_len(buf, n);
    }
    var r = _taar_resolv_parse(buf, len, cfg);
    if (r > 0) { return r; }
    if (r < 0) { return 0; }
    if (cut == 1) { return 0; }
    store64(cfg, _TAAR_RESOLV_FALLBACK);
    store64(cfg + _TAAR_RESOLV_CFG_COUNT, 1);
    return 1;
}

# Kernel-leased resolver (AGNOS net_config#61) → /etc/resolv.conf → 8.8.8.8,
# into `cfg`. On agnos the kernel learns the on-subnet DNS server from the DHCP
# lease; preferring it avoids the off-subnet 8.8.8.8 fallback, which needs
# working gateway routing the kernel can't guarantee on real iron (the
# QEMU-passed / iron-failed gap). _taar_plat_dns_server() returns 0 on Linux,
# so the resolv.conf path is unchanged there. Returns the nameserver count, or
# 0 when the resolve must fail closed; the rules are _taar_resolv_choose's.
fn _taar_resolv_discover(cfg): i64 {
    var ksrv = _taar_plat_dns_server();
    if (ksrv > 0) { return _taar_resolv_choose(ksrv, 0, 0, 0, cfg); }
    # Stack scratch, not alloc(): cyrius's alloc is a bump allocator with no
    # per-pointer free, so every heap byte taken here leaked for the process
    # lifetime — 4KB on each resolve. socket.cyr is allocator-free by design
    # and dns.cyr now matches it.
    var buf[4096];
    var n = _taar_plat_read_file("/etc/resolv.conf", &buf, 4096);
    return _taar_resolv_choose(0, &buf, n, 4096, cfg);
}

# --- TCP transport (RFC 1035 4.2.2) ---
#
# DNS over TCP is the same message body as UDP with a 2-byte big-endian length
# prefix, on a stream that may split or coalesce anywhere. Everything below
# exists to turn that stream back into one framed message.

# Write the length prefix + query into `out`. Pure; `out` needs qlen + 2 bytes.
# Returns the framed length, or 0 if qlen is out of range.
fn _taar_dns_tcp_frame(qbuf, qlen, out): i64 {
    if (qlen <= 0) { return 0; }
    if (qlen > 0xFFFF) { return 0; }
    store8(out, (qlen >> 8) & 0xFF);
    store8(out + 1, qlen & 0xFF);
    var i = 0;
    while (i < qlen) {
        store8(out + 2 + i, load8(qbuf + i));
        i = i + 1;
    }
    return qlen + 2;
}

# write(2) may accept fewer bytes than offered, so loop. A peer that keeps
# accepting zero is bounded by _TAAR_DNS_TCP_MAX_SPINS. Bytes sent, or -1.
fn _taar_dns_tcp_send_all(fd, buf, len): i64 {
    var off = 0;
    var spins = 0;
    while (off < len) {
        var n = taar_tcp_send(fd, buf + off, len - off);
        if (n < 0) { return 0 - 1; }
        if (n == 0) {
            spins = spins + 1;
            if (spins > _TAAR_DNS_TCP_MAX_SPINS) { return 0 - 1; }
        } else {
            off = off + n;
            spins = 0;
        }
    }
    return off;
}

# Read exactly `want` bytes. Returns how many were actually read — a short
# return means the peer closed (0), the deadline expired (_TAAR_ERR_TIMEOUT),
# the read failed, or the peer needed more than _TAAR_DNS_TCP_MAX_READS reads;
# the caller treats every one as a failed retry. Always terminates: at most
# _TAAR_DNS_TCP_MAX_READS reads, each bounded by the socket's receive timeout.
fn _taar_dns_tcp_read_all(fd, buf, want): i64 {
    var off = 0;
    var reads = 0;
    while (off < want) {
        if (reads >= _TAAR_DNS_TCP_MAX_READS) { return off; }
        reads = reads + 1;
        var n = taar_tcp_recv(fd, buf + off, want - off);
        if (n == _TAAR_ERR_INTR) { continue; }   # a signal; counted, so still bounded
        if (n <= 0) { return off; }
        off = off + n;
    }
    return off;
}

# Re-ask `qbuf` over TCP-53 and land the reply body in `rbuf`, every wait
# bounded by `timeout_ms`. Returns the message length (prefix excluded), or -1. A declared length larger than
# `rmax` is refused outright rather than truncated — a half-read message
# would parse as though it were whole.
fn _taar_dns_query_tcp(ns, qbuf, qlen, rbuf, rmax, timeout_ms): i64 {
    var out[304];                       # _TAAR_DNS_TCP_OUT_LEN
    # _taar_dns_tcp_frame allows any qlen up to 0xFFFF — correct for the framing
    # rule, but `out` is fixed. Every in-tree caller is bounded by
    # _taar_dns_build_query (271 max), so this only fires on a future caller;
    # it is here so the overflow cannot be introduced by one.
    if (qlen + 2 > _TAAR_DNS_TCP_OUT_LEN) { return 0 - 1; }
    var framed = _taar_dns_tcp_frame(qbuf, qlen, &out);
    if (framed == 0) { return 0 - 1; }

    var fd = taar_tcp_open();
    if (fd < 0) { return 0 - 1; }
    # Fail closed: without its deadlines this socket's connect and reads could
    # block indefinitely. (No test can make setsockopt fail on a fresh socket,
    # so this guard is untested; it costs one compare.)
    if (taar_tcp_set_timeout_ms(fd, timeout_ms) < 0) { taar_sock_close(fd); return 0 - 1; }
    if (taar_tcp_connect(fd, ns, 53) < 0) { taar_sock_close(fd); return 0 - 1; }
    if (_taar_dns_tcp_send_all(fd, &out, framed) < 0) { taar_sock_close(fd); return 0 - 1; }

    var lb[2];
    if (_taar_dns_tcp_read_all(fd, &lb, 2) != 2) { taar_sock_close(fd); return 0 - 1; }
    var mlen = (load8(&lb) << 8) | load8(&lb + 1);
    if (mlen < _TAAR_DNS_HEADER_LEN) { taar_sock_close(fd); return 0 - 1; }
    if (mlen > rmax) { taar_sock_close(fd); return 0 - 1; }

    var got = _taar_dns_tcp_read_all(fd, rbuf, mlen);
    taar_sock_close(fd);
    if (got != mlen) { return 0 - 1; }
    return mlen;
}

# Apply the same acceptance rules as the UDP path to a reply sitting in `buf`.
# 1 if it is a usable answer to our query, 0 otherwise.
fn _taar_dns_reply_ok(qbuf, qlen, buf, len, id): i64 {
    # Ordering guard: the header readers below index buf+2..buf+7, so a
    # sub-header message must be rejected before they run or they would
    # interpret whatever the receive buffer still held. The question-echo
    # check at the bottom would also reject it, which is why removing this
    # line does not move the test suite — keep it anyway, it is what makes
    # the reads above it in-bounds rather than merely harmless.
    if (len < _TAAR_DNS_HEADER_LEN) { return 0; }
    if (_taar_dns_hdr_qr(buf) != 1) { return 0; }
    if (_taar_dns_hdr_opcode(buf) != 0) { return 0; }
    if (_taar_dns_hdr_id(buf) != id) { return 0; }
    if (_taar_dns_hdr_qdcount(buf) != 1) { return 0; }
    if (_taar_dns_same_question(qbuf, qlen, buf, len) != 1) { return 0; }
    return 1;
}

# Ask nameserver `ns` the query in `qbuf` (its ID is stamped here, fresh for
# every server asked), waiting up to `timeout_ms` per receive. Returns:
#   >= 0                the address
#   -1                  a final "no address": NXDOMAIN, NOERROR with no A
#                       record, or a local failure no other server can fix
#                       (entropy, sockets)
#   _TAAR_DNS_TRY_NEXT  this server gave no verdict: no matching reply, a
#                       send error, a server failure (SERVFAIL, REFUSED,
#                       NOTIMP, FORMERR), or a truncated reply with no answer
#                       whose TCP retry failed too
#
# Reply acceptance is deliberately strict (RFC 5452). A datagram is only
# parsed for answers once it is a response (QR=1), carries our query ID,
# holds exactly one question, and echoes that question byte-for-byte. Anything
# not from the nameserver we sent to is dropped before that: by the Linux
# kernel, because taar_udp_send connects the socket, and on AGNOS by
# taar_udp_recv itself. Non-matching datagrams are skipped and the wait
# resumes, up to _TAAR_DNS_MAX_REPLIES — a receive a signal interrupted
# (_TAAR_ERR_INTR: Linux does not restart a recv with SO_RCVTIMEO set) counts
# as one of them, so a signal no longer ends the resolve.
#
# Tradeoff: the worst-case wait per server becomes _TAAR_DNS_MAX_REPLIES × the
# timeout instead of a single one, if something can land a non-matching
# datagram just before each expiry. Doing that takes datagrams forged with the
# nameserver's address and port, which an off-path sender can do blind — but
# it only delays the resolve; none of them is accepted without the right ID
# and question. A spoofed ICMP port-unreachable can end the wait early (the
# connected socket reports -ECONNREFUSED); the result is the next server,
# never a wrong answer.
fn _taar_dns_ask(ns, qbuf, qlen, timeout_ms): i64 {
    # Fail closed on an entropy failure: a guessable query ID is worse than
    # not resolving.
    var id = _taar_plat_random_u16();
    if (id < 0) { return 0 - 1; }
    _taar_dns_store_u16(qbuf, 0, id);

    var fd = taar_udp_open();
    if (fd < 0) { return 0 - 1; }
    # Fail closed: without SO_RCVTIMEO the receive below could block forever.
    # (Untested for the same reason as the TCP twin in _taar_dns_query_tcp.)
    if (taar_udp_set_timeout_ms(fd, timeout_ms) < 0) { taar_udp_close(fd); return 0 - 1; }

    var sent = taar_udp_send(fd, ns, 53, qbuf, qlen);
    if (sent < 0) { taar_udp_close(fd); return _TAAR_DNS_TRY_NEXT; }

    var rbuf[2048];
    var rn = 0 - 1;
    var tries = 0;
    while (tries < _TAAR_DNS_MAX_REPLIES) {
        tries = tries + 1;
        var n = taar_udp_recv(fd, &rbuf, _TAAR_DNS_RBUF_LEN);
        if (n == _TAAR_ERR_INTR) { continue; }
        if (n < 0) { break; }                                          # timeout / error
        if (_taar_dns_reply_ok(qbuf, qlen, &rbuf, n, id) != 1) { continue; }
        rn = n;
        break;
    }
    taar_udp_close(fd);

    if (rn < 0) { return _TAAR_DNS_TRY_NEXT; }
    var rcode = _taar_dns_hdr_rcode(&rbuf);
    if (rcode == _TAAR_DNS_RCODE_NXDOMAIN) { return 0 - 1; }
    if (rcode != _TAAR_DNS_RCODE_NOERROR) { return _TAAR_DNS_TRY_NEXT; }
    var answer = _taar_dns_first_a(&rbuf, rn);
    if (_taar_dns_hdr_tc(&rbuf) != 1) { return answer; }

    # TC set: the RRset did not fit in a datagram, so what we just parsed is a
    # prefix of the real answer. Re-ask over TCP-53, which has no 512-byte
    # ceiling. Read the UDP answer out first — the retry reuses rbuf.
    #
    # Every failure path falls back to `answer`, the truncated-but-valid
    # datagram result, which is exactly what taar returned before this retry
    # existed. The retry can therefore only improve an answer, never lose one.
    # With no answer in the datagram either, this server has said nothing
    # usable, and the next one is asked.
    var fallback = answer;
    if (fallback < 0) { fallback = _TAAR_DNS_TRY_NEXT; }
    var tn = _taar_dns_query_tcp(ns, qbuf, qlen, &rbuf, _TAAR_DNS_RBUF_LEN, timeout_ms);
    if (tn < 0) { return fallback; }
    if (_taar_dns_reply_ok(qbuf, qlen, &rbuf, tn, id) != 1) { return fallback; }
    if (_taar_dns_hdr_rcode(&rbuf) != _TAAR_DNS_RCODE_NOERROR) { return fallback; }
    var tcp_answer = _taar_dns_first_a(&rbuf, tn);
    if (tcp_answer < 0) { return fallback; }
    return tcp_answer;
}

# === public ===

# Resolve `host` (cstr) to an IPv4 (packed first-octet-high-byte). A literal
# dotted-quad short-circuits. Returns -1 on failure (no resolver, NXDOMAIN, no
# A record, or no server answered).
#
# Up to three nameservers, in resolv.conf order, are asked in turn, for
# `options attempts:` rounds (default 2), each query waiting up to
# `options timeout:` seconds per receive (default 5) — the stub-resolver
# behaviour of glibc and musl. NXDOMAIN and a NOERROR answer are final; a
# server that does not answer, or answers SERVFAIL / REFUSED / NOTIMP /
# FORMERR, hands over to the next. Two differences from glibc: the timeout
# stays fixed across rounds (glibc doubles it per round), and RES_OPTIONS in
# the environment is not read. The acceptance rules for a reply are
# _taar_dns_ask's.
fn taar_resolve_ipv4(host): i64 {
    if (host == 0) { return 0 - 1; }
    if (load8(host) == 0) { return 0 - 1; }
    var lit = ipv4_parse(host);
    if (lit >= 0) { return lit; }

    var cfg[48];
    var count = _taar_resolv_discover(&cfg);
    if (count <= 0) { return 0 - 1; }

    var qbuf[300];
    var qlen = _taar_dns_build_query(&qbuf, 0, host);   # the ID is stamped per server
    if (qlen <= 0) { return 0 - 1; }

    var timeout_ms = load64(&cfg + _TAAR_RESOLV_CFG_TIMEOUT);
    var attempts = load64(&cfg + _TAAR_RESOLV_CFG_ATTEMPTS);
    var round = 0;
    while (round < attempts) {
        var i = 0;
        while (i < count) {
            var r = _taar_dns_ask(load64(&cfg + i * 8), &qbuf, qlen, timeout_ms);
            if (r != _TAAR_DNS_TRY_NEXT) { return r; }
            i = i + 1;
        }
        round = round + 1;
    }
    return 0 - 1;
}
