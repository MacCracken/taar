# taar — top-level test entry (referenced by cyrius.cyml [build].test).
# For unit tests, add cases to tests/taar.tcyr.

include "lib/syscalls.cyr"

# No-op entry point. `[build].test` in cyrius.cyml must name a compilable
# program; the real assertions live in tests/taar.tcyr, which `cyrius tests`
# discovers directly. Exits 0.
fn main() {
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
