# taar — raw-syscall socket primitives (UDP + TCP) + platform entropy/file.
#
# The sovereign transport substrate for the AGNOS network-tools family
# (yo / dig / whirl). Two backends, selected at compile time by the cyrius
# emit target (no lib/net.cyr — the family per-backend posture: thin, no
# tagged-union wrappers):
#
#   #ifndef CYRIUS_TARGET_AGNOS  → POSIX/Linux: socket(2) family via the
#                                  stdlib's ARCH-DISPATCHED sys_* wrappers.
#   #ifdef  CYRIUS_TARGET_AGNOS  → AGNOS: sovereign sock_*#47-50 / udp_*#51-54
#                                  + getrandom#45 + the FS / uptime / sleep
#                                  wrappers from cyrius's agnos syscall lib.
#
# The taar_* API surface is identical across both — consumers (whirl's
# transport.cyr, taar's own dns.cyr) never branch on target. The two
# platform helpers DNS needs (`_taar_plat_random_u16`, `_taar_plat_read_file`)
# live here too, so dns.cyr stays platform-neutral RFC-1035 framing.
#
# Allocator-free: all scratch (sockaddr_in, timeval) is function-local stack.
# AGNOS is connection-id based, so its TCP path tracks one active conn in a
# module global (taar is single-connection-at-a-time, single-threaded).
#
# IPv4 addresses are packed first-octet-in-high-byte (0xC0A80101 = 192.168.1.1),
# matching taar's ipv4_parse / ipv4_format_to_buf and the agnos kernel's ip4().
#
# SYSCALL NUMBERS COME FROM THE STDLIB, NEVER FROM LITERALS.
#
# cyrius's aarch64 backend rewrites the x86_64 syscall numbers it recognises
# (ESYSXLAT), so most hardcoded literals happen to survive a --aarch64 build.
# The exceptions are the numbers it deliberately cannot remap — those that
# collide with a different native aarch64 call — and they fail SILENTLY.
# taar shipped one: sendto. x86_64 44 is sendto; aarch64 44 is fstatfs(2), and
# there was no ESYSXLAT entry (nor, until cyrius 6.6.5, a stdlib wrapper) for
# it. Verified under
# qemu-aarch64: the old raw `syscall(44, fd, pkt, len, …)` returned 0 as though
# it had sent nothing, wrote ~120 bytes of struct statfs over the caller's
# packet buffer, and left every DNS resolve to time out. A --aarch64 build was
# clean; only running it showed the break.
#
# So: go through the stdlib's arch-dispatched sys_* wrappers. Where one does
# not exist, restructure to a call that has one — taar_udp_send connects and
# write(2)s, which is how taar avoided sendto before 6.6.5 added `sys_sendto`.

# ===================================================================
# Shared (backend-independent) — pure address packing, no syscalls.
# ===================================================================

var _TAAR_AF_INET     = 2;
var _TAAR_SOCK_STREAM = 1;
var _TAAR_SOCK_DGRAM  = 2;
var _TAAR_IPPROTO_TCP = 6;
var _TAAR_IPPROTO_UDP = 17;
var _TAAR_SOL_SOCKET  = 1;
var _TAAR_SO_RCVTIMEO = 20;   # asm-generic, so x86_64 and aarch64 agree
var _TAAR_SO_SNDTIMEO = 21;

# Receive-deadline expiry, returned by both recv paths on both backends.
# -11 is Linux's -EAGAIN, which is literally what a SO_RCVTIMEO expiry yields
# from read(2)/recvfrom(2) — so the AGNOS poll loops report a timeout using the
# same value the kernel would, and callers need one check, not two.
var _TAAR_ERR_TIMEOUT = 0 - 11;

# Fill a caller-provided 16-byte buffer as a sockaddr_in for `packed_addr`
# (first-octet-high-byte) + `port` (written network byte order).
#
# Defined outside both #ifdef arms: it is pure byte packing with no syscall,
# and the module contract promises an identical taar_* surface on every
# target. It previously lived inside the Linux arm only, so an AGNOS-target
# consumer calling it failed to link.
fn taar_fill_sockaddr(sa, packed_addr, port): i64 {
    var i = 0;
    while (i < 16) { store8(sa + i, 0); i = i + 1; }
    store8(sa, _TAAR_AF_INET);            # AF_INET low byte (2); high byte stays 0
    store8(sa + 2, (port >> 8) & 0xFF);   # port hi (network order)
    store8(sa + 3, port & 0xFF);          # port lo
    store8(sa + 4, (packed_addr >> 24) & 0xFF);
    store8(sa + 5, (packed_addr >> 16) & 0xFF);
    store8(sa + 6, (packed_addr >> 8)  & 0xFF);
    store8(sa + 7, packed_addr & 0xFF);
    return 0;
}

# 2 random bytes as a u16 — the DNS query ID (RFC 5452), and on AGNOS the
# ephemeral source port. getrandom(2) on Linux, RDRAND-backed getrandom#45 on
# AGNOS; the wrapper has the same shape on both, so this lives once, here.
#
# The buffer is zeroed and the byte count checked: an unchecked draw once left
# it uninitialised, and stack garbage became the query ID — the opposite of the
# unpredictability the ID exists for. Returns -1 if the kernel would not supply
# entropy; callers must fail closed rather than proceed with a guessable value.
fn _taar_plat_random_u16(): i64 {
    var b[2];
    store8(&b, 0);
    store8(&b + 1, 0);
    var n = sys_getrandom(&b, 2, 0);
    if (n != 2) { return 0 - 1; }
    return (load8(&b) << 8) | load8(&b + 1);
}

# Deadline for a poll loop starting at `now` (ms) with a `timeout_ms` budget, or
# -1 for none. 0 means "no deadline", as SO_RCVTIMEO's 0 means "block
# indefinitely" on Linux. Pure, so the suite tests it on any host; only the
# AGNOS arm polls.
fn _taar_poll_deadline(now, timeout_ms): i64 {
    if (timeout_ms <= 0) { return 0 - 1; }
    return now + timeout_ms;
}

# 1 once `now` has reached `deadline`; never for the no-deadline value -1.
fn _taar_poll_expired(now, deadline): i64 {
    if (deadline < 0) { return 0; }
    if (now >= deadline) { return 1; }
    return 0;
}

# Did a datagram come from the peer we sent to? `from` is the 16-byte record the
# AGNOS udp_recv#53 kernel fills (source ip @+0 in the packed first-octet-high
# form, source port @+8). A zero `peer_port` means nothing has been sent yet,
# which, like an unconnected socket, accepts any sender. 1 = accept, 0 = drop.
fn _taar_peer_match(from, peer_ip, peer_port): i64 {
    if (peer_port == 0) { return 1; }
    if (load64(from) != peer_ip) { return 0; }
    if (load64(from + 8) != peer_port) { return 0; }
    return 1;
}

#ifndef CYRIUS_TARGET_AGNOS
# ===================================================================
# POSIX/Linux backend — socket(2) family via arch-dispatched sys_* wrappers.
# ===================================================================

# --- UDP (DNS) ---

# Open an unbound UDP socket. The source port is assigned by the kernel on
# first send. Returns the fd, or a negative errno.
fn taar_udp_open(): i64 {
    return sys_socket(_TAAR_AF_INET, _TAAR_SOCK_DGRAM, _TAAR_IPPROTO_UDP);
}

# Set SO_RCVTIMEO or SO_SNDTIMEO (`optname`) to `timeout_ms`, as the struct
# timeval {tv_sec, tv_usec} both take. 0 = no limit. Returns 0, or a negative
# errno (a negative timeout is refused by the kernel with -EDOM).
fn _taar_set_sock_timeout(fd, optname, timeout_ms): i64 {
    var tv[16];
    store64(&tv, timeout_ms / 1000);
    store64(&tv + 8, (timeout_ms % 1000) * 1000);
    return sys_setsockopt(fd, _TAAR_SOL_SOCKET, optname, &tv, 16);
}

# Bound how long a single taar_udp_recv will block, via SO_RCVTIMEO. An expiry
# then surfaces as _TAAR_ERR_TIMEOUT. 0 means block indefinitely. Returns 0, or
# a negative errno.
fn taar_udp_set_timeout_ms(fd, timeout_ms): i64 {
    return _taar_set_sock_timeout(fd, _TAAR_SO_RCVTIMEO, timeout_ms);
}

# connect(2) the datagram socket to the peer, then write(2).
#
# Deliberately connect-then-write rather than sendto(2). Two reasons:
#   1. Security. A connected UDP socket makes the kernel drop datagrams whose
#      source address/port is not the peer, so an off-path attacker must guess
#      the ephemeral source port on top of the 16-bit DNS ID. Unconnected, any
#      host that guessed the ID alone could land a forged answer (RFC 5452).
#   2. Portability (historical). Until cyrius 6.6.5 the stdlib had no sendto
#      wrapper and no SYS_SENDTO, and hardcoding 44 was the aarch64 misroute
#      fixed in 0.3.3 (44 is fstatfs there). `sys_sendto` exists now, so this
#      reason no longer applies; reason 1 alone keeps connect-then-write.
# Re-connecting a UDP socket to a new peer is legal and cheap, so per-send
# connect keeps the (fd, addr, port) signature intact. Bytes sent, or <0.
fn taar_udp_send(fd, packed_addr, port, pkt, pkt_len): i64 {
    var sa[16];
    taar_fill_sockaddr(&sa, packed_addr, port);
    var c = sys_connect(fd, &sa, 16);
    if (c < 0) { return c; }
    return sys_write(fd, pkt, pkt_len);
}

# Receive one datagram. Because taar_udp_send connects the socket, the kernel
# has already dropped anything not from that peer. Returns bytes received (>0),
# or a negative errno — _TAAR_ERR_TIMEOUT if the receive deadline expired.
# A datagram longer than maxlen is truncated to it.
fn taar_udp_recv(fd, buf, maxlen): i64 {
    return sys_recvfrom(fd, buf, maxlen, 0, 0, 0);
}

# Release a UDP socket. Split from taar_sock_close because AGNOS unbinds a
# listener rather than closing a connection.
fn taar_udp_close(fd): i64 {
    return sys_close(fd);
}

# --- TCP ---

# Open a TCP socket. Returns the fd, or a negative errno. Pair with
# taar_tcp_connect; release with taar_sock_close.
fn taar_tcp_open(): i64 {
    return sys_socket(_TAAR_AF_INET, _TAAR_SOCK_STREAM, _TAAR_IPPROTO_TCP);
}

# Bound how long a single connect, send or recv on this socket will block.
# 0 means block indefinitely. Returns 0, or a negative errno. Call it before
# taar_tcp_connect for the connect to be bounded.
#
#   - recv (SO_RCVTIMEO): an expiry is _TAAR_ERR_TIMEOUT, distinct from the 0
#     that means the peer closed.
#   - send (SO_SNDTIMEO): a send that cannot write anything before the deadline
#     is _TAAR_ERR_TIMEOUT; one that wrote some bytes returns that count.
#   - connect (also SO_SNDTIMEO): a handshake that does not finish in time
#     fails with -EINPROGRESS.
#
# Until 0.6.2 this set SO_RCVTIMEO only, and Linux bounds connect(2) by
# SO_SNDTIMEO, so a connect to a host whose SYNs were dropped (a filtered port)
# waited out the kernel's SYN retries, about 127 s, whatever timeout the caller
# had asked for.
fn taar_tcp_set_timeout_ms(fd, timeout_ms): i64 {
    var r = _taar_set_sock_timeout(fd, _TAAR_SO_RCVTIMEO, timeout_ms);
    if (r < 0) { return r; }
    return _taar_set_sock_timeout(fd, _TAAR_SO_SNDTIMEO, timeout_ms);
}

# Connect to packed_addr:port. Blocks until the handshake completes, fails, or
# the kernel gives up. Returns 0 on success, or a negative errno.
fn taar_tcp_connect(fd, packed_addr, port): i64 {
    var sa[16];
    taar_fill_sockaddr(&sa, packed_addr, port);
    return sys_connect(fd, &sa, 16);
}

# write(2). Returns bytes accepted, which may be < len on a partial write —
# the caller loops. (Unchanged contract; noted because it is easy to miss.)
fn taar_tcp_send(fd, buf, len): i64 {
    return sys_write(fd, buf, len);
}

# Read from the stream. Returns bytes read (>0), 0 when the peer has closed
# cleanly, or a negative errno — _TAAR_ERR_TIMEOUT if the receive deadline
# expired. Distinguishing those last two is what lets a caller tell a finished
# response from a stalled one; see the AGNOS peer, which now matches.
fn taar_tcp_recv(fd, buf, maxlen): i64 {
    return sys_read(fd, buf, maxlen);
}

# Release a TCP socket.
fn taar_sock_close(fd): i64 {
    return sys_close(fd);
}

# --- platform helpers (file + resolver lease) for dns.cyr ---
# (_taar_plat_random_u16 is shared; it sits above both arms.)

# openat(AT_FDCWD, path, O_RDONLY) + read + close. Bytes read, or <0.
# Used for /etc/resolv.conf. openat via the stdlib because bare open(2) is
# x86_64-only — aarch64 has no SYS_OPEN at all.
fn _taar_plat_read_file(path, buf, maxlen): i64 {
    var fd = sys_openat(AT_FDCWD, path, O_RDONLY, 0);
    if (fd < 0) { return fd; }
    var n = sys_read(fd, buf, maxlen);
    sys_close(fd);
    return n;
}

# Linux has no kernel-provided resolver to query — DNS discovery uses
# /etc/resolv.conf. Return 0 so _taar_resolv_discover falls through to the file.
fn _taar_plat_dns_server(): i64 { return 0; }
#endif

#ifdef CYRIUS_TARGET_AGNOS
# ===================================================================
# AGNOS backend — sovereign sock_*#47-50 / udp_*#51-54 syscalls.
#
# Model bridges the POSIX surface needs on AGNOS:
#   1. No socket()+connect() split: sock_connect(dst_ip,dst_port,src_port)→conn_id
#      combines them. taar_tcp_open just resets the conn slot; taar_tcp_connect
#      does the real work and stashes the conn_id (single active conn).
#   2. sock_recv#49 / udp_recv#53 are NON-BLOCKING (>0 data / 0 WOULD_BLOCK /
#      -1 EOF for TCP; >0 / 0 none / -1 for UDP) with no SO_RCVTIMEO analog —
#      so the recv path polls against an uptime_ms deadline. taar_tcp_recv maps
#      the result back to the Linux blocking-read sense its callers expect
#      (>0 data, 0 = peer closed).
#   3. src ports are drawn from getrandom#45 (49152..65535 ephemeral range).
#   4. A UDP listener is not "connected": the kernel delivers any datagram
#      addressed to its port, whoever sent it (net_handle_udp matches the
#      destination port only). taar_udp_send records the peer and
#      taar_udp_recv drops anything else, which is what connect(2) makes the
#      Linux kernel do. Without it an off-path forger needs no source-address
#      spoofing at all, only the port and the query ID.
#
# ⚠ State is module-global, not per socket: one timeout, one TCP conn, one UDP
# peer. taar is single-connection-at-a-time here, so a consumer that holds a
# TCP connection open across a taar_resolve_ipv4 call can have it disturbed by
# the resolver's TC retry. Per-socket state is a roadmap item; it lands with
# executed AGNOS coverage, since nothing runs this arm yet.
# ===================================================================

var _taar_ag_conn       = 0 - 1;     # active TCP conn_id (0..7), -1 = none
var _taar_ag_src_port   = 0;         # bound UDP source port (for packed-ports)
var _taar_ag_timeout_ms = 10000;     # recv-poll deadline window (set per-call)
var _taar_ag_peer_ip    = 0;         # UDP peer recorded by taar_udp_send
var _taar_ag_peer_port  = 0;         # 0 = none yet (accept any sender)

# Draw an ephemeral source port 49152..65535 from hardware entropy (RDRAND).
# Returns -1 if the kernel would not supply entropy: a source port derived
# from uninitialised stack is a predictable port, which is precisely the
# off-path-spoofing hole ephemeral randomisation exists to close.
fn _taar_ag_ephemeral_port(): i64 {
    var r = _taar_plat_random_u16();
    if (r < 0) { return 0 - 1; }
    return 49152 + (r & 0x3FFF);
}

# --- UDP (DNS) ---

# Bind an ephemeral UDP source port so the reply routes back. Returns the
# listener_id (0..7) as the "fd", or <0 (entropy unavailable / table full).
fn taar_udp_open(): i64 {
    var port = _taar_ag_ephemeral_port();
    if (port < 0) { return 0 - 1; }
    var lid = sys_udp_bind(port);
    if (lid < 0) { return lid; }
    _taar_ag_src_port = port;
    _taar_ag_peer_ip = 0;
    _taar_ag_peer_port = 0;
    return lid;
}

# No SO_RCVTIMEO on AGNOS — remember the timeout for the recv poll loop.
# 0 = no deadline, as on Linux. Returns 0, or -1 for a negative timeout (Linux
# refuses one too).
fn taar_udp_set_timeout_ms(fd, timeout_ms): i64 {
    if (timeout_ms < 0) { return 0 - 1; }
    _taar_ag_timeout_ms = timeout_ms;
    return 0;
}

# udp_send(dst_ip, (src_port<<16)|dst_port, pkt, len). packed_addr is the ip4()
# packed form (high byte = first octet) the kernel expects. Records the peer so
# taar_udp_recv can drop other senders (see note 4 above). Returns pkt_len on
# success, as Linux write(2) does: the kernel reports the frame length
# (payload + 42 bytes of headers), which a caller comparing against pkt_len
# would misread. -1 on failure.
fn taar_udp_send(fd, packed_addr, port, pkt, pkt_len): i64 {
    _taar_ag_peer_ip = packed_addr;
    _taar_ag_peer_port = port & 0xFFFF;
    var packed_ports = (_taar_ag_src_port << 16) | _taar_ag_peer_port;
    var r = sys_udp_send(packed_addr, packed_ports, pkt, pkt_len);
    if (r > 0) { return pkt_len; }
    return r;
}

# Non-blocking kernel recv polled against an uptime_ms deadline. Returns bytes
# received (>0), _TAAR_ERR_TIMEOUT on deadline expiry (matching what Linux
# SO_RCVTIMEO yields), or a kernel error (<0). Polls at least once, so a reply
# already waiting is returned even with a short deadline. A datagram from any
# host but the peer taar_udp_send recorded is dropped and the wait continues.
# The 5ms inter-poll sleep keeps us off a busy-spin.
fn taar_udp_recv(fd, buf, maxlen): i64 {
    var deadline = _taar_poll_deadline(sys_uptime_ms(), _taar_ag_timeout_ms);
    var from[16];
    while (1) {
        store64(&from, 0);
        store64(&from + 8, 0);
        var n = sys_udp_recv(fd, buf, maxlen, &from);
        if (n < 0) { return n; }
        if (n > 0) {
            if (_taar_peer_match(&from, _taar_ag_peer_ip, _taar_ag_peer_port) == 1) { return n; }
        }
        if (_taar_poll_expired(sys_uptime_ms(), deadline) == 1) { return _TAAR_ERR_TIMEOUT; }
        sys_sleep_ms(5);
    }
    return _TAAR_ERR_TIMEOUT;
}

# Release the UDP listener (udp_unbind#54). Split from taar_sock_close, which
# closes a TCP conn_id — on AGNOS these are different kernel objects.
fn taar_udp_close(fd): i64 {
    return sys_udp_unbind(fd);
}

# --- TCP ---

# No separate socket() on AGNOS — reset the conn slot; connect does the work.
fn taar_tcp_open(): i64 {
    _taar_ag_conn = 0 - 1;
    return 0;
}

# No SO_RCVTIMEO on AGNOS — remember the deadline window for the recv poll
# loop. 0 = no deadline. Returns 0, or -1 for a negative timeout. Bounds recv
# only: sock_connect#47 and sock_send#48 carry their own ~8 s kernel windows.
fn taar_tcp_set_timeout_ms(fd, timeout_ms): i64 {
    if (timeout_ms < 0) { return 0 - 1; }
    _taar_ag_timeout_ms = timeout_ms;
    return 0;
}

# sock_connect(dst_ip, dst_port, src_port) → conn_id 0..7 (BLOCKS ~8s) / -1.
# Stashes the conn_id; returns 0 on success or the kernel's negative error.
fn taar_tcp_connect(fd, packed_addr, port): i64 {
    var sport = _taar_ag_ephemeral_port();
    if (sport < 0) { return 0 - 1; }
    var conn = sys_sock_connect(packed_addr, port, sport);
    if (conn < 0) { return conn; }
    _taar_ag_conn = conn;
    return 0;
}

# sock_send#48 (blocks). Bytes sent (<= len) / -1.
fn taar_tcp_send(fd, buf, len): i64 {
    return sys_sock_send(_taar_ag_conn, buf, len);
}

# Poll sock_recv#49 (>0 data / 0 WOULD_BLOCK / -1 EOF) against the deadline,
# mapping to the Linux blocking-read sense. Returns bytes read (>0), 0 when the
# peer closed cleanly, or _TAAR_ERR_TIMEOUT on deadline expiry. Polls at least
# once.
#
# ⚠ The kernel answers -1 for EOF AND for a reset or dead connection, so both
# read as 0 here, where Linux returns -ECONNRESET for the second. taar cannot
# tell them apart until sock_recv#49 does; a consumer reading to EOF on AGNOS
# can mistake a mid-body reset for a complete response. Tracked in the roadmap.
#
# Through 0.4.0 a deadline expiry also returned 0 — indistinguishable from a
# clean close, so a peer that stalled mid-body made a truncated read look like
# a finished one, and the caller had no way to tell. Two things made that the
# odd one out: the Linux peer already separates them (a SO_RCVTIMEO expiry is
# -EAGAIN from read(2), a close is 0), and this file's own taar_udp_recv
# already returned -11 on timeout. The AGNOS TCP path was the only place the
# two collapsed, against a module contract that promises an identical surface.
fn taar_tcp_recv(fd, buf, maxlen): i64 {
    var deadline = _taar_poll_deadline(sys_uptime_ms(), _taar_ag_timeout_ms);
    while (1) {
        var n = sys_sock_recv(_taar_ag_conn, buf, maxlen);
        if (n > 0) { return n; }
        if (n < 0) { return 0; }        # -1 = EOF → "peer closed" (see ⚠ above)
        if (_taar_poll_expired(sys_uptime_ms(), deadline) == 1) { return _TAAR_ERR_TIMEOUT; }
        sys_sleep_ms(2);                # 0 = WOULD_BLOCK → keep polling
    }
    return _TAAR_ERR_TIMEOUT;
}

# Close the active TCP conn (sock_close#50) and clear the slot. Safe to call
# when no conn is open. Returns the kernel result, or 0 if there was nothing
# to close.
fn taar_sock_close(fd): i64 {
    if (_taar_ag_conn < 0) { return 0; }
    var r = sys_sock_close(_taar_ag_conn);
    _taar_ag_conn = 0 - 1;
    return r;
}

# --- platform helpers (file + resolver lease) for dns.cyr ---
# (_taar_plat_random_u16 is shared; it sits above both arms.)

# open(name,namelen,O_RDONLY)+read+close via the AGNOS FS syscalls. AGNOS
# sys_open takes (name, namelen, flags) — compute the cstring length inline.
# On agnos /etc/resolv.conf is typically absent → sys_open < 0 → dns falls back.
fn _taar_plat_read_file(path, buf, maxlen): i64 {
    var nl = 0;
    while (load8(path + nl) != 0) { nl = nl + 1; }
    var fd = sys_open(path, nl, 0);
    if (fd < 0) { return fd; }
    var n = sys_read(fd, buf, maxlen);
    sys_close(fd);
    return n;
}

# The DHCP-leased DNS resolver (option 6, else the leased gateway), packed
# first-octet-high-byte; 0 if unconfigured. Preferred over /etc/resolv.conf
# (typically absent on agnos) and over the off-subnet public fallback
# (8.8.8.8): the leased resolver is on-subnet, so it routes without depending
# on gateway-MAC egress.
#
# 0.3.1 shipped this as a raw `syscall(61, 3)` because cyrius had no wrapper.
# 6.5.35 ships one, so the literal is gone — the last in taar. The agnos
# syscall lib spells out why that matters: #61 is net_config on AGNOS but
# wait4(2) on Linux. The #ifdef kept us safe, but a number that means two
# different things on two kernels does not belong in a source file.
fn _taar_plat_dns_server(): i64 { return sys_net_dns_server(); }
#endif
