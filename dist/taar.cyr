# taar.cyr -- bundled distribution
# Version: 0.3.3
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- ipv4.cyr ---

# ipv4.cyr — strict dotted-quad IPv4 address codec (taar substrate).
#
# taar's canonical home for IPv4 parse/format. Supersedes the
# byte-identical in-tree copies that yo (src/ipv4.cyr) and dig
# (src/ipv4.cyr) carried before the extraction — both fold onto this
# module via [deps.taar]. The duplication between those two tools was
# the documented extraction trigger.
#
# Single-purpose. Pure code (no syscalls). Mirrors
# agnos/kernel/core/net.cyr ip4() packing:
#   (a<<24) | (b<<16) | (c<<8) | d
# so a parsed address is byte-comparable with kernel-side struct fields
# and ready directly as the packed-addr argument to the agnos
# sock_connect / udp_send syscalls. Hostname/DNS resolution is a
# separate concern (taar/src/dns.cyr, folds in when a consumer needs it).
#
# Strict grammar: D '.' D '.' D '.' D '\0'  where D = one to three
# decimal digits, value in [0, 255]. No empty segments. No leading
# garbage. No trailing garbage. No spaces.

var IPV4_PARSE_FAIL = 0 - 1;   # i64 sentinel; any valid packed v4 is ≤ 0xFFFFFFFF.

# Parse a dotted-quad into a packed u32. Returns the packed address on
# success, IPV4_PARSE_FAIL on any rejection. Caller checks `result < 0`
# to detect failure.
fn ipv4_parse(s): i64 {
    if (s == 0) { return IPV4_PARSE_FAIL; }
    var i = 0;
    var packed = 0;
    var seg = 0;
    while (seg < 4) {
        var oct = 0;
        var digits = 0;
        var c = load8(s + i);
        while (c >= 48) {
            if (c > 57) { break; }
            oct = oct * 10 + (c - 48);
            if (oct > 255) { return IPV4_PARSE_FAIL; }
            digits = digits + 1;
            if (digits > 3) { return IPV4_PARSE_FAIL; }
            i = i + 1;
            c = load8(s + i);
        }
        if (digits == 0) { return IPV4_PARSE_FAIL; }
        packed = (packed << 8) | oct;
        if (seg < 3) {
            if (c != 46) { return IPV4_PARSE_FAIL; }   # '.' = 46
            i = i + 1;
        } else {
            if (c != 0) { return IPV4_PARSE_FAIL; }    # must terminate after 4th octet
        }
        seg = seg + 1;
    }
    return packed;
}

# Format a packed v4 as dotted-quad into buf. Buf must hold at least
# 16 bytes (worst case "255.255.255.255\0" = 16). Returns bytes
# written (without a trailing NUL).
fn ipv4_format_to_buf(packed_addr, buf): i64 {
    var pos = 0;
    pos = pos + fmt_int_buf((packed_addr >> 24) & 0xFF, buf + pos);
    store8(buf + pos, 46); pos = pos + 1;
    pos = pos + fmt_int_buf((packed_addr >> 16) & 0xFF, buf + pos);
    store8(buf + pos, 46); pos = pos + 1;
    pos = pos + fmt_int_buf((packed_addr >> 8)  & 0xFF, buf + pos);
    store8(buf + pos, 46); pos = pos + 1;
    pos = pos + fmt_int_buf(packed_addr & 0xFF, buf + pos);
    return pos;
}

# --- socket.cyr ---

# taar — raw-syscall socket primitives (UDP + TCP) + platform entropy/file.
#
# The sovereign transport substrate for the AGNOS network-tools family
# (yo / dig / whirl). Two backends, selected at compile time by the cyrius
# emit target (no lib/net.cyr — the family per-backend posture: thin, no
# tagged-union wrappers):
#
#   #ifndef CYRIUS_TARGET_AGNOS  → POSIX/Linux: socket(2) family via the
#                                  stdlib's ARCH-DISPATCHED sys_* wrappers.
#   #ifdef  CYRIUS_TARGET_AGNOS  → AGNOS: sovereign sock_*#47-50 / udp_*#51-54
#                                  + getrandom#45 + the FS / uptime / sleep
#                                  wrappers from cyrius's agnos syscall lib.
#
# The taar_* API surface is identical across both — consumers (whirl's
# transport.cyr, taar's own dns.cyr) never branch on target. The two
# platform helpers DNS needs (`_taar_plat_random_u16`, `_taar_plat_read_file`)
# live here too, so dns.cyr stays platform-neutral RFC-1035 framing.
#
# Allocator-free: all scratch (sockaddr_in, timeval) is function-local stack.
# AGNOS is connection-id based, so its TCP path tracks one active conn in a
# module global (taar is single-connection-at-a-time, single-threaded).
#
# IPv4 addresses are packed first-octet-in-high-byte (0xC0A80101 = 192.168.1.1),
# matching taar's ipv4_parse / ipv4_format_to_buf and the agnos kernel's ip4().
#
# SYSCALL NUMBERS COME FROM THE STDLIB, NEVER FROM LITERALS.
#
# cyrius's aarch64 backend rewrites the x86_64 syscall numbers it recognises
# (ESYSXLAT), so most hardcoded literals happen to survive a --aarch64 build.
# The exceptions are the numbers it deliberately cannot remap — those that
# collide with a different native aarch64 call — and they fail SILENTLY.
# taar shipped one: sendto. x86_64 44 is sendto; aarch64 44 is fstatfs(2), and
# there is no ESYSXLAT entry (nor stdlib wrapper) for it. Verified under
# qemu-aarch64: the old raw `syscall(44, fd, pkt, len, …)` returned 0 as though
# it had sent nothing, wrote ~120 bytes of struct statfs over the caller's
# packet buffer, and left every DNS resolve to time out. A --aarch64 build was
# clean; only running it showed the break.
#
# So: go through the stdlib's arch-dispatched sys_* wrappers. Where one does
# not exist (there is no sendto wrapper), restructure to a call that has one —
# see taar_udp_send, which connects and write(2)s instead.

# ===================================================================
# Shared (backend-independent) — pure address packing, no syscalls.
# ===================================================================

var _TAAR_AF_INET     = 2;
var _TAAR_SOCK_STREAM = 1;
var _TAAR_SOCK_DGRAM  = 2;
var _TAAR_IPPROTO_TCP = 6;
var _TAAR_IPPROTO_UDP = 17;
var _TAAR_SOL_SOCKET  = 1;
var _TAAR_SO_RCVTIMEO = 20;

# Fill a caller-provided 16-byte buffer as a sockaddr_in for `packed_addr`
# (first-octet-high-byte) + `port` (written network byte order).
#
# Defined outside both #ifdef arms: it is pure byte packing with no syscall,
# and the module contract promises an identical taar_* surface on every
# target. It previously lived inside the Linux arm only, so an AGNOS-target
# consumer calling it failed to link.
fn taar_fill_sockaddr(sa, packed_addr, port): i64 {
    var i = 0;
    while (i < 16) { store8(sa + i, 0); i = i + 1; }
    store8(sa, _TAAR_AF_INET);            # AF_INET low byte (2); high byte stays 0
    store8(sa + 2, (port >> 8) & 0xFF);   # port hi (network order)
    store8(sa + 3, port & 0xFF);          # port lo
    store8(sa + 4, (packed_addr >> 24) & 0xFF);
    store8(sa + 5, (packed_addr >> 16) & 0xFF);
    store8(sa + 6, (packed_addr >> 8)  & 0xFF);
    store8(sa + 7, packed_addr & 0xFF);
    return 0;
}

#ifndef CYRIUS_TARGET_AGNOS
# ===================================================================
# POSIX/Linux backend — socket(2) family via arch-dispatched sys_* wrappers.
# ===================================================================

# --- UDP (DNS) ---

fn taar_udp_open(): i64 {
    return sys_socket(_TAAR_AF_INET, _TAAR_SOCK_DGRAM, _TAAR_IPPROTO_UDP);
}

fn taar_udp_set_timeout_ms(fd, timeout_ms): i64 {
    var tv[16];
    store64(&tv, timeout_ms / 1000);
    store64(&tv + 8, (timeout_ms % 1000) * 1000);
    return sys_setsockopt(fd, _TAAR_SOL_SOCKET, _TAAR_SO_RCVTIMEO, &tv, 16);
}

# connect(2) the datagram socket to the peer, then write(2).
#
# Deliberately connect-then-write rather than sendto(2). Two reasons:
#   1. Security. A connected UDP socket makes the kernel drop datagrams whose
#      source address/port is not the peer, so an off-path attacker must guess
#      the ephemeral source port on top of the 16-bit DNS ID. Unconnected, any
#      host that guessed the ID alone could land a forged answer (RFC 5452).
#   2. Portability. The stdlib exposes no sendto wrapper and no SYS_SENDTO
#      constant, and hardcoding 44 is exactly the aarch64 misroute this module
#      is fixing (44 is fstatfs there). write(2) on a connected socket needs
#      neither.
# Re-connecting a UDP socket to a new peer is legal and cheap, so per-send
# connect keeps the (fd, addr, port) signature intact. Bytes sent, or <0.
fn taar_udp_send(fd, packed_addr, port, pkt, pkt_len): i64 {
    var sa[16];
    taar_fill_sockaddr(&sa, packed_addr, port);
    var c = sys_connect(fd, &sa, 16);
    if (c < 0) { return c; }
    return sys_write(fd, pkt, pkt_len);
}

fn taar_udp_recv(fd, buf, maxlen): i64 {
    return sys_recvfrom(fd, buf, maxlen, 0, 0, 0);
}

fn taar_udp_close(fd): i64 {
    return sys_close(fd);
}

# --- TCP ---

fn taar_tcp_open(): i64 {
    return sys_socket(_TAAR_AF_INET, _TAAR_SOCK_STREAM, _TAAR_IPPROTO_TCP);
}

fn taar_tcp_set_timeout_ms(fd, timeout_ms): i64 {
    var tv[16];
    store64(&tv, timeout_ms / 1000);
    store64(&tv + 8, (timeout_ms % 1000) * 1000);
    return sys_setsockopt(fd, _TAAR_SOL_SOCKET, _TAAR_SO_RCVTIMEO, &tv, 16);
}

fn taar_tcp_connect(fd, packed_addr, port): i64 {
    var sa[16];
    taar_fill_sockaddr(&sa, packed_addr, port);
    return sys_connect(fd, &sa, 16);
}

# write(2). Returns bytes accepted, which may be < len on a partial write —
# the caller loops. (Unchanged contract; noted because it is easy to miss.)
fn taar_tcp_send(fd, buf, len): i64 {
    return sys_write(fd, buf, len);
}

fn taar_tcp_recv(fd, buf, maxlen): i64 {
    return sys_read(fd, buf, maxlen);
}

fn taar_sock_close(fd): i64 {
    return sys_close(fd);
}

# --- platform helpers (entropy + file) for dns.cyr ---

# 2 bytes for the DNS query ID (RFC 5452), via getrandom(2).
#
# Was open("/dev/urandom")+read with the read result ignored: a short or
# failed read left the 2-byte stack buffer UNINITIALISED and its garbage
# became the query ID — the opposite of the unpredictability RFC 5452 asks
# for. Now zero-initialised, drawn with getrandom(2) (no fd, no path, and
# arch-dispatched), and the byte count is checked. Returns -1 if the kernel
# would not supply entropy; the caller must fail closed rather than resolve
# with a guessable ID.
fn _taar_plat_random_u16(): i64 {
    var b[2];
    store8(&b, 0);
    store8(&b + 1, 0);
    var n = sys_getrandom(&b, 2, 0);
    if (n != 2) { return 0 - 1; }
    return (load8(&b) << 8) | load8(&b + 1);
}

# openat(AT_FDCWD, path, O_RDONLY) + read + close. Bytes read, or <0.
# Used for /etc/resolv.conf. openat via the stdlib because bare open(2) is
# x86_64-only — aarch64 has no SYS_OPEN at all.
fn _taar_plat_read_file(path, buf, maxlen): i64 {
    var fd = sys_openat(AT_FDCWD, path, O_RDONLY, 0);
    if (fd < 0) { return fd; }
    var n = sys_read(fd, buf, maxlen);
    sys_close(fd);
    return n;
}

# Linux has no kernel-provided resolver to query — DNS discovery uses
# /etc/resolv.conf. Return 0 so _taar_resolv_discover falls through to the file.
fn _taar_plat_dns_server(): i64 { return 0; }
#endif

#ifdef CYRIUS_TARGET_AGNOS
# ===================================================================
# AGNOS backend — sovereign sock_*#47-50 / udp_*#51-54 syscalls.
#
# Model bridges the POSIX surface needs on AGNOS:
#   1. No socket()+connect() split: sock_connect(dst_ip,dst_port,src_port)→conn_id
#      combines them. taar_tcp_open just resets the conn slot; taar_tcp_connect
#      does the real work and stashes the conn_id (single active conn).
#   2. sock_recv#49 / udp_recv#53 are NON-BLOCKING (>0 data / 0 WOULD_BLOCK /
#      -1 EOF for TCP; >0 / 0 none / -1 for UDP) with no SO_RCVTIMEO analog —
#      so the recv path polls against an uptime_ms deadline. taar_tcp_recv maps
#      the result back to the Linux blocking-read sense its callers expect
#      (>0 data, 0 = peer closed).
#   3. src ports are drawn from getrandom#45 (49152..65535 ephemeral range).
# ===================================================================

var _taar_ag_conn       = 0 - 1;     # active TCP conn_id (0..7), -1 = none
var _taar_ag_src_port   = 0;         # bound UDP source port (for packed-ports)
var _taar_ag_timeout_ms = 10000;     # recv-poll deadline window (set per-call)

# Draw an ephemeral source port 49152..65535 from hardware entropy (RDRAND).
# Returns -1 if the kernel would not supply entropy: a source port derived
# from uninitialised stack is a predictable port, which is precisely the
# off-path-spoofing hole ephemeral randomisation exists to close.
fn _taar_ag_ephemeral_port(): i64 {
    var rb[2];
    store8(&rb, 0);
    store8(&rb + 1, 0);
    var n = sys_getrandom(&rb, 2, 0);
    if (n != 2) { return 0 - 1; }
    return 49152 + (((load8(&rb) << 8) | load8(&rb + 1)) & 0x3FFF);
}

# --- UDP (DNS) ---

# Bind an ephemeral UDP source port so the reply routes back. Returns the
# listener_id (0..7) as the "fd", or <0 (entropy unavailable / table full).
fn taar_udp_open(): i64 {
    var port = _taar_ag_ephemeral_port();
    if (port < 0) { return 0 - 1; }
    var lid = sys_udp_bind(port);
    if (lid < 0) { return lid; }
    _taar_ag_src_port = port;
    return lid;
}

# No SO_RCVTIMEO on AGNOS — remember the timeout for the recv poll loop.
fn taar_udp_set_timeout_ms(fd, timeout_ms): i64 {
    _taar_ag_timeout_ms = timeout_ms;
    return 0;
}

# udp_send(dst_ip, (src_port<<16)|dst_port, pkt, len). packed_addr is the ip4()
# packed form (high byte = first octet) the kernel expects. Bytes sent / -1.
fn taar_udp_send(fd, packed_addr, port, pkt, pkt_len): i64 {
    var packed_ports = (_taar_ag_src_port << 16) | (port & 0xFFFF);
    return sys_udp_send(packed_addr, packed_ports, pkt, pkt_len);
}

# Non-blocking kernel recv polled against an uptime_ms deadline. Returns bytes
# received (>0), -11 (-EAGAIN-ish on timeout, matching Linux SO_RCVTIMEO), or a
# kernel error (<0). The 5ms inter-poll sleep keeps us off a busy-spin.
fn taar_udp_recv(fd, buf, maxlen): i64 {
    var deadline = sys_uptime_ms() + _taar_ag_timeout_ms;
    while (sys_uptime_ms() < deadline) {
        var n = sys_udp_recv(fd, buf, maxlen, 0);
        if (n > 0) { return n; }
        if (n < 0) { return n; }
        sys_sleep_ms(5);
    }
    return 0 - 11;
}

fn taar_udp_close(fd): i64 {
    return sys_udp_unbind(fd);
}

# --- TCP ---

# No separate socket() on AGNOS — reset the conn slot; connect does the work.
fn taar_tcp_open(): i64 {
    _taar_ag_conn = 0 - 1;
    return 0;
}

fn taar_tcp_set_timeout_ms(fd, timeout_ms): i64 {
    _taar_ag_timeout_ms = timeout_ms;
    return 0;
}

# sock_connect(dst_ip, dst_port, src_port) → conn_id 0..7 (BLOCKS ~8s) / -1.
# Stashes the conn_id; returns 0 on success or the kernel's negative error.
fn taar_tcp_connect(fd, packed_addr, port): i64 {
    var sport = _taar_ag_ephemeral_port();
    if (sport < 0) { return 0 - 1; }
    var conn = sys_sock_connect(packed_addr, port, sport);
    if (conn < 0) { return conn; }
    _taar_ag_conn = conn;
    return 0;
}

# sock_send#48 (blocks). Bytes sent (<= len) / -1.
fn taar_tcp_send(fd, buf, len): i64 {
    return sys_sock_send(_taar_ag_conn, buf, len);
}

# Poll sock_recv#49 (>0 data / 0 WOULD_BLOCK / -1 EOF) against the deadline,
# mapping to the Linux blocking-read sense: >0 data, 0 = peer closed / timeout.
#
# CAVEAT (unchanged contract, documented): a deadline expiry is reported as 0,
# the same value as a clean peer close, so a caller cannot distinguish "the
# response ended" from "the response stalled". A peer that stalls mid-body can
# therefore make a truncated read look complete. Fixing this means giving
# timeout its own negative return, which is a breaking change for whirl's
# transport — tracked in docs/development/state.md carry-forward.
fn taar_tcp_recv(fd, buf, maxlen): i64 {
    var deadline = sys_uptime_ms() + _taar_ag_timeout_ms;
    while (sys_uptime_ms() < deadline) {
        var n = sys_sock_recv(_taar_ag_conn, buf, maxlen);
        if (n > 0) { return n; }
        if (n < 0) { return 0; }        # -1 = EOF → "peer closed"
        sys_sleep_ms(2);                # 0 = WOULD_BLOCK → keep polling
    }
    return 0;                            # timeout → treat as closed
}

fn taar_sock_close(fd): i64 {
    if (_taar_ag_conn < 0) { return 0; }
    var r = sys_sock_close(_taar_ag_conn);
    _taar_ag_conn = 0 - 1;
    return r;
}

# --- platform helpers (entropy + file) for dns.cyr ---

# 2 bytes of hardware entropy (RDRAND) for the DNS query ID (RFC 5452).
# -1 if the kernel would not supply it (see the Linux peer: an unchecked
# draw yields an uninitialised, guessable ID).
fn _taar_plat_random_u16(): i64 {
    var rb[2];
    store8(&rb, 0);
    store8(&rb + 1, 0);
    var n = sys_getrandom(&rb, 2, 0);
    if (n != 2) { return 0 - 1; }
    return (load8(&rb) << 8) | load8(&rb + 1);
}

# open(name,namelen,O_RDONLY)+read+close via the AGNOS FS syscalls. AGNOS
# sys_open takes (name, namelen, flags) — compute the cstring length inline.
# On agnos /etc/resolv.conf is typically absent → sys_open < 0 → dns falls back.
fn _taar_plat_read_file(path, buf, maxlen): i64 {
    var nl = 0;
    while (load8(path + nl) != 0) { nl = nl + 1; }
    var fd = sys_open(path, nl, 0);
    if (fd < 0) { return fd; }
    var n = sys_read(fd, buf, maxlen);
    sys_close(fd);
    return n;
}

# AGNOS net_config(field=3) → the DHCP-leased DNS resolver (option 6, else the
# leased gateway), packed first-octet-high-byte; 0 if unconfigured / -1 on an
# unknown field. Preferred over /etc/resolv.conf (typically absent on agnos) and
# over the off-subnet public fallback (8.8.8.8): the leased resolver is on-subnet,
# so it routes without depending on gateway-MAC egress. Raw syscall #61 by design —
# cyrius >= the release that ships `sys_net_config` will let this drop to the wrapper
# (see the cyrius issue 2026-06-23-agnos-net-config-syscall-wrapper). a2..a4 unused.
var _TAAR_AG_SYS_NET_CONFIG = 61;
fn _taar_plat_dns_server(): i64 { return syscall(_TAAR_AG_SYS_NET_CONFIG, 3); }
#endif

# --- dns.cyr ---

# taar — DNS resolver: hostname → IPv4 (A record), over UDP-53.
#
# Ported from dig's dns.cyr (RFC 1035 framing) + resolv.cyr (resolver discovery),
# narrowed to the A-record resolve path the net-tools family needs. Builds on
# taar's ipv4 + socket modules. Public surface = `taar_resolve_ipv4(host)`.
#
# All framing helpers are `_taar_dns_*` / `_taar_resolv_*`-prefixed so this
# coexists with dig's own src/dns.cyr until dig is refactored onto taar.
#
# Requires earlier in the bundle: src/ipv4.cyr, src/socket.cyr.

var _TAAR_DNS_TYPE_A        = 1;
var _TAAR_DNS_CLASS_IN      = 1;
var _TAAR_DNS_FLAG_RD       = 0x0100;
var _TAAR_DNS_HEADER_LEN    = 12;
var _TAAR_DNS_MAX_LABEL     = 63;
var _TAAR_DNS_MAX_NAME      = 255;
var _TAAR_DNS_MAX_HOPS      = 32;
var _TAAR_DNS_RCODE_NOERROR = 0;
# Datagrams to examine before giving up on a matching reply. Stray, duplicate
# and forged packets are discarded and the wait continues rather than aborting
# the whole resolve — one unmatched packet used to be enough to kill it.
var _TAAR_DNS_MAX_REPLIES   = 8;
# Scratch sizes. Query: 12 header + 255 max wire name + 4 qtype/qclass = 271.
# Reply: 2048 covers the 512-byte classic UDP limit with EDNS headroom.
var _TAAR_DNS_QBUF_LEN      = 300;
var _TAAR_DNS_RBUF_LEN      = 2048;

var _TAAR_RESOLV_FALLBACK = 0x08080808;   # 8.8.8.8

# Entropy + file reads come from socket.cyr's platform helpers
# (_taar_plat_random_u16 / _taar_plat_read_file) so this module stays
# platform-neutral RFC-1035 framing across the Linux / AGNOS backends.

# --- wire framing (RFC 1035) ---

fn _taar_dns_store_u16(buf, off, val): i64 {
    store8(buf + off, (val >> 8) & 0xFF);
    store8(buf + off + 1, val & 0xFF);
    return 0;
}
fn _taar_dns_load_u16(buf, off): i64 {
    return (load8(buf + off) << 8) | load8(buf + off + 1);
}
fn _taar_dns_hdr_id(msg): i64      { return (load8(msg) << 8) | load8(msg + 1); }
fn _taar_dns_hdr_qdcount(msg): i64 { return (load8(msg + 4) << 8) | load8(msg + 5); }
fn _taar_dns_hdr_ancount(msg): i64 { return (load8(msg + 6) << 8) | load8(msg + 7); }
fn _taar_dns_hdr_rcode(msg): i64   { return ((load8(msg + 2) << 8) | load8(msg + 3)) & 0x0F; }
# QR (bit 15 of the flags word): 1 = response, 0 = query. An unsolicited query
# arriving at our source port must never be parsed as though it were an answer.
fn _taar_dns_hdr_qr(msg): i64      { return (load8(msg + 2) >> 7) & 1; }
# TC (bit 9): the server truncated the message. Not rejected here — any A
# record that did fit is still authoritative-as-sent — but a caller that needs
# the complete RRset must retry over TCP. That fallback is a roadmap item
# (docs/development/roadmap.md → "DNS TCP fallback on TC").
fn _taar_dns_hdr_tc(msg): i64      { return (load8(msg + 2) >> 1) & 1; }

# Encode "example.com" → wire labels at `out`. Returns bytes written, or 0.
fn _taar_dns_encode_name(name, out): i64 {
    var src = 0;
    var dst = 0;
    var label_start = dst;
    store8(out + dst, 0);
    dst = dst + 1;
    while (1) {
        var c = load8(name + src);
        if (c == 0) {
            if (dst - label_start == 1) {
                # src == 0 → the whole name was empty; anything else is a
                # legitimate trailing dot ("example.com."), already terminated.
                if (src == 0) { return 0; }
                return dst;
            }
            var llen = dst - label_start - 1;
            if (llen > _TAAR_DNS_MAX_LABEL) { return 0; }
            store8(out + label_start, llen);
            store8(out + dst, 0);
            dst = dst + 1;
            if (dst > _TAAR_DNS_MAX_NAME) { return 0; }
            return dst;
        }
        if (c == 46) {
            var llen2 = dst - label_start - 1;
            if (llen2 == 0) { return 0; }
            if (llen2 > _TAAR_DNS_MAX_LABEL) { return 0; }
            store8(out + label_start, llen2);
            label_start = dst;
            store8(out + dst, 0);
            dst = dst + 1;
        } else {
            store8(out + dst, c);
            dst = dst + 1;
        }
        if (dst > _TAAR_DNS_MAX_NAME) { return 0; }
        src = src + 1;
    }
    return 0;
}

# Build an A/IN query for `name` into `buf`. Returns total length or 0.
fn _taar_dns_build_query(buf, id, name): i64 {
    _taar_dns_store_u16(buf, 0, id);
    _taar_dns_store_u16(buf, 2, _TAAR_DNS_FLAG_RD);
    _taar_dns_store_u16(buf, 4, 1);    # QDCOUNT
    _taar_dns_store_u16(buf, 6, 0);
    _taar_dns_store_u16(buf, 8, 0);
    _taar_dns_store_u16(buf, 10, 0);
    var n = _taar_dns_encode_name(name, buf + _TAAR_DNS_HEADER_LEN);
    if (n == 0) { return 0; }
    _taar_dns_store_u16(buf, _TAAR_DNS_HEADER_LEN + n, _TAAR_DNS_TYPE_A);
    _taar_dns_store_u16(buf, _TAAR_DNS_HEADER_LEN + n + 2, _TAAR_DNS_CLASS_IN);
    return _TAAR_DNS_HEADER_LEN + n + 4;
}

# Skip a wire name; return the offset past it. Backward-pointer + hop-budget
# guarded (rejects crafted pointer loops). 0 on parse error.
fn _taar_dns_skip_name(msg, msg_len, off): i64 {
    var cur = off;
    var end_off = 0;
    var hops = 0;
    while (1) {
        if (cur >= msg_len) { return 0; }
        var b = load8(msg + cur);
        if (b == 0) {
            cur = cur + 1;
            if (end_off == 0) { end_off = cur; }
            return end_off;
        }
        if ((b & 0xC0) == 0xC0) {
            if (cur + 1 >= msg_len) { return 0; }
            var b2 = load8(msg + cur + 1);
            var ptr = ((b & 0x3F) << 8) | b2;
            # Redundant given the `ptr >= cur` rule below (cur < msg_len is
            # already established at the top of the loop) — kept as a bound
            # that survives if that ordering is ever refactored.
            if (ptr >= msg_len) { return 0; }
            if (end_off == 0) { end_off = cur + 2; }
            hops = hops + 1;
            if (hops > _TAAR_DNS_MAX_HOPS) { return 0; }
            if (ptr >= cur) { return 0; }
            cur = ptr;
        } else {
            if (b > _TAAR_DNS_MAX_LABEL) { return 0; }
            cur = cur + 1 + b;
        }
    }
    return 0;
}

# Offset of the answer section (past the question(s)), or 0.
fn _taar_dns_answer_start(msg, msg_len): i64 {
    if (msg_len < _TAAR_DNS_HEADER_LEN) { return 0; }
    var qd = _taar_dns_hdr_qdcount(msg);
    var off = _TAAR_DNS_HEADER_LEN;
    var i = 0;
    while (i < qd) {
        var p = _taar_dns_skip_name(msg, msg_len, off);
        if (p == 0) { return 0; }
        if (p + 4 > msg_len) { return 0; }
        off = p + 4;
        i = i + 1;
    }
    return off;
}

# First A-record IPv4 (packed first-octet-high-byte) in the answer section, or -1.
fn _taar_dns_first_a(msg, msg_len): i64 {
    var off = _taar_dns_answer_start(msg, msg_len);
    if (off == 0) { return 0 - 1; }
    var an = _taar_dns_hdr_ancount(msg);
    var i = 0;
    while (i < an) {
        var p = _taar_dns_skip_name(msg, msg_len, off);
        if (p == 0) { return 0 - 1; }
        if (p + 10 > msg_len) { return 0 - 1; }
        var rtype = _taar_dns_load_u16(msg, p);
        var rdlen = _taar_dns_load_u16(msg, p + 8);
        var rdata = p + 10;
        if (rdata + rdlen > msg_len) { return 0 - 1; }
        if (rtype == _TAAR_DNS_TYPE_A) {
            if (rdlen == 4) {
                var o0 = load8(msg + rdata);
                var o1 = load8(msg + rdata + 1);
                var o2 = load8(msg + rdata + 2);
                var o3 = load8(msg + rdata + 3);
                return (o0 << 24) | (o1 << 16) | (o2 << 8) | o3;
            }
        }
        off = rdata + rdlen;
        i = i + 1;
    }
    return 0 - 1;
}

# Does the reply echo back the exact question we asked?
#
# RFC 1035 requires a server to copy the question section verbatim, so a
# byte-compare of [12, qlen) against the query we sent binds the reply to this
# specific QNAME/QTYPE/QCLASS. Without it, a reply carrying the right ID could
# answer a different question entirely and taar would take its first A record.
fn _taar_dns_same_question(qbuf, qlen, rbuf, rlen): i64 {
    if (qlen <= _TAAR_DNS_HEADER_LEN) { return 0; }
    if (rlen < qlen) { return 0; }
    var i = _TAAR_DNS_HEADER_LEN;
    while (i < qlen) {
        if (load8(rbuf + i) != load8(qbuf + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# --- resolv.conf discovery (ported from dig's resolv.cyr) ---

fn _taar_resolv_skip_blank(buf, len, i): i64 {
    while (i < len) {
        var c = load8(buf + i);
        if (c == 32) { i = i + 1; }
        elif (c == 9) { i = i + 1; }
        else { return i; }
    }
    return i;
}
fn _taar_resolv_find_eol(buf, len, i): i64 {
    while (i < len) {
        if (load8(buf + i) == 10) { return i; }
        i = i + 1;
    }
    return len;
}
fn _taar_resolv_match(buf, len, i, lit, lit_len): i64 {
    if (i + lit_len > len) { return 0; }
    var k = 0;
    while (k < lit_len) {
        if (load8(buf + i + k) != load8(lit + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# First `nameserver X.X.X.X` IPv4 (packed), or 0.
fn _taar_resolv_parse(buf, len): i64 {
    if (buf == 0) { return 0; }
    if (len <= 0) { return 0; }
    var i = 0;
    while (i < len) {
        i = _taar_resolv_skip_blank(buf, len, i);
        if (i >= len) { return 0; }
        var c = load8(buf + i);
        if (c == 35) { i = _taar_resolv_find_eol(buf, len, i) + 1; }
        elif (c == 59) { i = _taar_resolv_find_eol(buf, len, i) + 1; }
        elif (c == 10) { i = i + 1; }
        else {
            if (_taar_resolv_match(buf, len, i, "nameserver", 10) == 1) {
                var j = i + 10;
                if (j < len) {
                    var nc = load8(buf + j);
                    if (nc == 32) { j = _taar_resolv_skip_blank(buf, len, j); }
                    elif (nc == 9) { j = _taar_resolv_skip_blank(buf, len, j); }
                    else { i = _taar_resolv_find_eol(buf, len, i) + 1; continue; }
                    var eol = _taar_resolv_find_eol(buf, len, j);
                    var end = j;
                    while (end < eol) {
                        var ec = load8(buf + end);
                        if (ec == 32) { break; }
                        if (ec == 9) { break; }
                        end = end + 1;
                    }
                    var tlen = end - j;
                    if (tlen > 0) {
                        if (tlen <= 64) {
                            var tmp[80];
                            var k2 = 0;
                            while (k2 < tlen) { store8(&tmp + k2, load8(buf + j + k2)); k2 = k2 + 1; }
                            store8(&tmp + tlen, 0);
                            var addr = ipv4_parse(&tmp);
                            if (addr >= 0) { return addr; }
                        }
                    }
                    i = eol + 1;
                } else { return 0; }
            } else {
                i = _taar_resolv_find_eol(buf, len, i) + 1;
            }
        }
    }
    return 0;
}

# Kernel-leased resolver (AGNOS net_config#61) → /etc/resolv.conf → 8.8.8.8.
# On agnos the kernel learns the on-subnet DNS server from the DHCP lease;
# preferring it avoids the off-subnet 8.8.8.8 fallback, which needs working
# gateway routing the kernel can't guarantee on real iron (the QEMU-passed /
# iron-failed gap). _taar_plat_dns_server() returns 0 on Linux, so the
# resolv.conf path is unchanged there.
fn _taar_resolv_discover(): i64 {
    var ksrv = _taar_plat_dns_server();
    if (ksrv > 0) { return ksrv; }
    # Stack scratch, not alloc(): cyrius's alloc is a bump allocator with no
    # per-pointer free, so every heap byte taken here leaked for the process
    # lifetime — 4KB on each resolve. socket.cyr is allocator-free by design
    # and dns.cyr now matches it.
    var buf[4096];
    var n = _taar_plat_read_file("/etc/resolv.conf", &buf, 4096);
    if (n > 0) {
        var addr = _taar_resolv_parse(&buf, n);
        if (addr > 0) { return addr; }
    }
    return _TAAR_RESOLV_FALLBACK;
}

# === public ===

# Resolve `host` (cstr) to an IPv4 (packed first-octet-high-byte). A literal
# dotted-quad short-circuits. Returns -1 on failure (resolve / timeout / no A).
#
# Reply acceptance is deliberately strict (RFC 5452). A datagram is only
# parsed for answers once it is a response (QR=1), carries our query ID,
# holds exactly one question, and echoes that question byte-for-byte. The
# kernel additionally drops anything not from the nameserver we sent to,
# because taar_udp_send connects the socket. Non-matching datagrams are
# skipped and the wait resumes, up to _TAAR_DNS_MAX_REPLIES.
#
# Tradeoff: the worst-case wait becomes _TAAR_DNS_MAX_REPLIES × the socket
# timeout (8 x 5s) instead of a single 5s, if something can land a
# non-matching datagram just before each expiry. Since the socket is
# connected, doing that requires forging the nameserver's own address and
# port — an on-path position. Trading that bounded latency for "one stray
# packet kills the resolve" is the right way round.
fn taar_resolve_ipv4(host): i64 {
    if (host == 0) { return 0 - 1; }
    if (load8(host) == 0) { return 0 - 1; }
    var lit = ipv4_parse(host);
    if (lit >= 0) { return lit; }

    # Fail closed on an entropy failure: resolving with a guessable query ID
    # is worse than not resolving.
    var id = _taar_plat_random_u16();
    if (id < 0) { return 0 - 1; }

    var ns = _taar_resolv_discover();
    if (ns <= 0) { return 0 - 1; }

    var qbuf[300];
    var qlen = _taar_dns_build_query(&qbuf, id, host);
    if (qlen <= 0) { return 0 - 1; }

    var fd = taar_udp_open();
    if (fd < 0) { return 0 - 1; }
    taar_udp_set_timeout_ms(fd, 5000);

    var sent = taar_udp_send(fd, ns, 53, &qbuf, qlen);
    if (sent < 0) { taar_udp_close(fd); return 0 - 1; }

    var rbuf[2048];
    var rn = 0 - 1;
    var tries = 0;
    while (tries < _TAAR_DNS_MAX_REPLIES) {
        tries = tries + 1;
        var n = taar_udp_recv(fd, &rbuf, 2048);
        if (n < 0) { break; }                                          # timeout / error
        if (n < _TAAR_DNS_HEADER_LEN) { continue; }                    # runt
        if (_taar_dns_hdr_qr(&rbuf) != 1) { continue; }                # not a response
        if (_taar_dns_hdr_id(&rbuf) != id) { continue; }               # not our query
        if (_taar_dns_hdr_qdcount(&rbuf) != 1) { continue; }           # malformed
        if (_taar_dns_same_question(&qbuf, qlen, &rbuf, n) != 1) { continue; }
        rn = n;
        break;
    }
    taar_udp_close(fd);

    if (rn < 0) { return 0 - 1; }
    if (_taar_dns_hdr_rcode(&rbuf) != _TAAR_DNS_RCODE_NOERROR) { return 0 - 1; }
    return _taar_dns_first_a(&rbuf, rn);
}
