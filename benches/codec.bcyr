# taar codec benchmarks — the pure, per-resolve CPU paths.
#
# Everything a resolve does that is not waiting on the network: the IPv4
# codec, sockaddr packing, query build, reply acceptance, answer parse and
# resolv.conf parse. Network latency (milliseconds) dwarfs all of these
# (nanoseconds), so these rows exist to catch a regression that makes a parser
# pathological, not to chase single nanoseconds.
#
#   cyrius bench benches/

# bench is a [test] stdlib leaf; included by name as well so an editor that
# compiles this file standalone resolves bench_* (includes are once-only).
include "lib/bench.cyr"
include "src/main.cyr"

var BENCH_ITERS = 20000;

var _b_buf = 0;        # 64-byte scratch for format / sockaddr
var _b_q = 0;          # query buffer
var _b_ql = 0;
var _b_r = 0;          # canned reply
var _b_rl = 0;
var _b_rc = 0;         # resolv.conf text
var _b_rcl = 0;
var _b_cfg = 0;        # resolver config block

# Copy a NUL-terminated literal into `dst`. Returns its length.
fn _b_put(dst, s): i64 {
    var i = 0;
    while (load8(s + i) != 0) { store8(dst + i, load8(s + i)); i = i + 1; }
    return i;
}

# A NOERROR reply for www.example.com: a CNAME to example.com, then its A
# record, so the answer walk skips one record and follows a compression
# pointer before it reaches the address. Returns the message length.
fn _b_canned_reply(buf, q, ql): i64 {
    var i = 0;
    while (i < ql) { store8(buf + i, load8(q + i)); i = i + 1; }
    _taar_dns_store_u16(buf, 2, 0x8180);              # QR|RD|RA, NOERROR
    _taar_dns_store_u16(buf, 6, 2);                   # ancount
    var off = ql;
    # CNAME: owner = ptr to the question name (offset 12), target = "example" + ptr.
    store8(buf + off, 0xC0); store8(buf + off + 1, 12); off = off + 2;
    _taar_dns_store_u16(buf, off, 5); off = off + 2;  # type CNAME
    _taar_dns_store_u16(buf, off, 1); off = off + 2;  # class IN
    _taar_dns_store_u16(buf, off, 0); _taar_dns_store_u16(buf, off + 2, 60); off = off + 4;
    _taar_dns_store_u16(buf, off, 2); off = off + 2;  # rdlength: a bare pointer
    store8(buf + off, 0xC0); store8(buf + off + 1, 16); off = off + 2;   # -> "example.com"
    # A: owner = ptr to "example.com" inside the question.
    store8(buf + off, 0xC0); store8(buf + off + 1, 16); off = off + 2;
    _taar_dns_store_u16(buf, off, 1); off = off + 2;  # type A
    _taar_dns_store_u16(buf, off, 1); off = off + 2;  # class IN
    _taar_dns_store_u16(buf, off, 0); _taar_dns_store_u16(buf, off + 2, 60); off = off + 4;
    _taar_dns_store_u16(buf, off, 4); off = off + 2;
    store8(buf + off, 93); store8(buf + off + 1, 184);
    store8(buf + off + 2, 216); store8(buf + off + 3, 34); off = off + 4;
    return off;
}

fn _bench_ipv4_parse() { ipv4_parse("192.168.100.200"); return 0; }
fn _bench_ipv4_format() { ipv4_format_to_buf(0xC0A864C8, _b_buf); return 0; }
fn _bench_fill_sockaddr() { taar_fill_sockaddr(_b_buf, 0xC0A864C8, 53); return 0; }
fn _bench_encode_name() { _taar_dns_encode_name("www.example.com", _b_buf); return 0; }
fn _bench_build_query() { _taar_dns_build_query(_b_q, 0x1234, "www.example.com"); return 0; }
fn _bench_reply_ok() { _taar_dns_reply_ok(_b_q, _b_ql, _b_r, _b_rl, 0x1234); return 0; }
fn _bench_first_a() { _taar_dns_first_a(_b_r, _b_rl); return 0; }
fn _bench_resolv_parse() { _taar_resolv_parse(_b_rc, _b_rcl, _b_cfg); return 0; }

# Runs every row and prints the report. Exits 0.
fn main() {
    alloc_init();
    _b_buf = alloc(64);
    _b_q = alloc(300);
    _b_ql = _taar_dns_build_query(_b_q, 0x1234, "www.example.com");
    _b_r = alloc(512);
    _b_rl = _b_canned_reply(_b_r, _b_q, _b_ql);
    if (_taar_dns_first_a(_b_r, _b_rl) != 0x5DB8D822) {
        println("bench setup: canned reply does not parse");
        return 1;
    }
    _b_rc = alloc(512);
    _b_cfg = alloc(48);
    var rc = "# Generated by NetworkManager\nsearch lan example.org\noptions edns0 trust-ad\n";
    _b_rcl = _b_put(_b_rc, rc);
    _b_rcl = _b_rcl + _b_put(_b_rc + _b_rcl, "nameserver 192.168.1.1\nnameserver 1.1.1.1\n");

    println("=== taar codec benchmarks ===");
    var b = bench_new("ipv4_parse");
    bench_run(b, &_bench_ipv4_parse, BENCH_ITERS); bench_report(b);
    b = bench_new("ipv4_format_to_buf");
    bench_run(b, &_bench_ipv4_format, BENCH_ITERS); bench_report(b);
    b = bench_new("taar_fill_sockaddr");
    bench_run(b, &_bench_fill_sockaddr, BENCH_ITERS); bench_report(b);
    b = bench_new("dns_encode_name");
    bench_run(b, &_bench_encode_name, BENCH_ITERS); bench_report(b);
    b = bench_new("dns_build_query");
    bench_run(b, &_bench_build_query, BENCH_ITERS); bench_report(b);
    b = bench_new("dns_reply_ok");
    bench_run(b, &_bench_reply_ok, BENCH_ITERS); bench_report(b);
    b = bench_new("dns_first_a (CNAME + A)");
    bench_run(b, &_bench_first_a, BENCH_ITERS); bench_report(b);
    b = bench_new("resolv_parse");
    bench_run(b, &_bench_resolv_parse, BENCH_ITERS); bench_report(b);
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
